; prgmθQR in Z80 assembly: the QR engine, ported from QRSRC.axe.txt
; (docs/asm_port.md). Assembled by spasm-ng (tools/build.py runs it), run by prgmQR with
; Asm(prgmθQR) exactly like the Axe engine; the interface is docs/API.md.
;
; Everything the Axe engine does: for Str1 (E=1) and a NoteFolio note (E=2, in
; RAM or archived), the check call (V=0: the length, the mode, the first problem character's
; position in B) and the draw calls (V=1-11: data codewords, error correction, the drawing,
; Ans = 0); and E=3, the list of notes in Str3 for prgmQR's menu.
;
; Rules for the whole program (the OS needs them): keep IY (the OS flags pointer), leave
; interrupts on, return with the stack where it started, put back the page in bank A (port 6,
; 4000h-7FFFh) after mapping an archived note there, and write only the scratch areas of
; design.md's memory map (saveSScreen = L₁, appBackUpScreen = L₃, plotSScreen = the graph
; buffer), OP1-OP6 and the program's own variables. Every bcall may change every register but
; IY (the tests make sure nothing counts on one surviving), and the OS's interrupt handler
; changes the shadow registers, so they are never used.

#include "ti83plus.inc"

; Answers in Ans besides lengths and 0 (docs/API.md). 65534 is prgmQR's own: it
; stores it before Asm(, so it is left if the engine didn't run.
AnsBadInput	= 65535		; bad E, V or M, or the input doesn't exist
AnsBadChar	= 65533		; a character the mode can't encode (its position in B)
AnsTooLong	= 65532		; a check of more than 32765 characters

; The engine's variables: the last 54 bytes of saveSScreen, where Axe keeps its own (which is
; why L₁ is 714 bytes, not 768), so L₁ keeps the same size as for the Axe engine. The Axe
; engine's letter for each is in brackets.
Vars		= saveSScreen+714
SaveSP		= Vars		; word: the stack pointer at the start, for Quit
Source		= Vars+2	; byte: [E] 1 Str1, 2 a note
Version		= Vars+3	; byte: [V] 0-11, 0 = only check
Mode		= Vars+4	; byte: [F] 0 auto, 1 ASCII (byte mode), 2 alphanumeric
InputPtr	= Vars+5	; word: [P] the input's first byte (Str1's first token)
Length		= Vars+7	; word: [T] the input's length in characters (Str1: tokens)
ReadPtr		= Vars+9	; word: [P] CH's place in Str1
Pos		= Vars+11	; word: [O] the position of the character CH read last (1 = first)
BadPos		= Vars+13	; word: [K] the first character that can't be encoded, 0 if none
NonAlnumPos	= Vars+15	; word: [X] the first one alphanumeric mode can't encode, 0 if none
Count		= Vars+17	; word: [N] characters to encode
Skip		= Vars+19	; word: [θ] characters to skip first
DataCount	= Vars+21	; word: [M] data codewords of the version (EC level L)
ECPerBlock	= Vars+23	; byte: [R] EC codewords per block
Blocks		= Vars+24	; byte: [B] number of blocks
OutPtr		= Vars+25	; word: [D] where AB stores the next full byte
BitAcc		= Vars+27	; byte: [W] the byte AB is filling
BitCount	= Vars+28	; byte: [K] bits in BitAcc, 0-7
ShortLen	= Vars+29	; byte: [Y] data codewords in a short block (M / B)
LongBlocks	= Vars+30	; byte: [U] blocks one codeword longer, the last ones (M mod B)
BlockPtr	= Vars+31	; word: [A] the next block's data codewords, for RS
ECPtr		= Vars+33	; word: [Z] where RS writes the next block's EC codewords
NotePage	= Vars+35	; byte: the open note's flash page, 0 if it is in RAM
NoteAddr	= Vars+36	; word: [Q] its data (after the size word): the address in RAM, or
				; in flash the offset from 4000h on NotePage (0-3FFFh)
NoteSize	= Vars+38	; word: [U] its size (the appvar's size word)
ListPtr		= Vars+40	; word: [P] the VAT entry LS is looking at
ListCount	= Vars+42	; byte: [K] notes listed so far (at most 80)
ListSize	= Vars+43	; word: Str3's size: 8 per name, real and blank (whole pages of 5)

; The drawing's variables don't fit in those 54 bytes, so they go in L₁'s free space at +600
; (design.md's memory map leaves L₁+503..699 unused)
DrawVars	= saveSScreen+600
Size		= DrawVars	; byte: [S] modules per side, 4V+17
RowOff		= DrawVars+1	; byte: [G] screen row of the symbol's top row (centered)
ColOff		= DrawVars+2	; byte: [H] screen column of its left column
AlignMid	= DrawVars+3	; byte: [W] the middle alignment coordinate, 0 below v7
AlignCount	= DrawVars+4	; byte: [A] alignment coordinates (2 or 3)
AlignX		= DrawVars+5	; byte: the alignment loops' counters
AlignY		= DrawVars+6
ShortBlocks	= DrawVars+7	; byte: [U] blocks of ShortLen codewords (the first ones)
BlockShift	= DrawVars+8	; byte: log₂ of the number of blocks (1, 2 or 4 → 0-2)
ShortTotal	= DrawVars+9	; word: ShortLen · blocks
ECTotal		= DrawVars+11	; word: EC codewords in all (R · blocks)
CWIndex		= DrawVars+13	; word: [Q] the codeword being drawn, in interleaved order
CWByte		= DrawVars+15	; byte: [D] that codeword
CWBit		= DrawVars+16	; byte: [Z] the mask of its next bit, from 80h down
ZigPair		= DrawVars+17	; byte: [K] the zigzag's column pair, from the right
ZigCol		= DrawVars+18	; byte: [X] that pair's right column
ZigStep		= DrawVars+19	; byte: [I] the step along the pair (0 to S-1)
RectOp		= DrawVars+20	; byte: Rect's operation, 0 fill, 1 invert
VersionBits	= DrawVars+21	; word: the version information still to draw
VersionIdx	= DrawVars+23	; byte: its bit number, 0-17

; Work areas (design.md's memory map)
DataOut		= saveSScreen		; the data codewords, block after block (at most 324; a bad
					; N can run on to L₁+470, short of Align)
NameList	= saveSScreen		; E=3: the notes' names, 8 bytes each (at most 80, then up
					; to 4 blank ones: L₁+0..671)
SortBuf		= saveSScreen+690	; E=3: the name SortNames is placing
Map		= appBackUpScreen	; while drawing: the function modules, one pixel each, at
					; module coordinates (no offset), like a 96×64 screen
Align		= saveSScreen+500	; alignment pattern coordinates (2 or 3)
AppvarName	= saveSScreen+700	; OP1-style name of the note: 15h, the name, 0
ECOut		= saveSScreen+330	; EC codewords, block after block, R apart
Gen		= saveSScreen+420	; generator polynomial: 1, then R coefficients as logs
Rem		= saveSScreen+460	; RS remainder, R+1 bytes
ExpTable	= appBackUpScreen	; 2^i at +i, written twice (i = 0-509) so a sum of two
					; logs needs no mod 255
LogTable	= appBackUpScreen+512	; log of x at +x (x = 1-255)

	.org userMem-2
	.db t2ByteTok, tasmCmp		; BB 6D: a compiled assembly program, run by Asm(

Start:
	ld (SaveSP),sp

; Full: 15 MHz on a TI-84+ or a Silver Edition, nothing on a plain TI-83+. Port 2 bit 7 is
; set on the models that have the fast mode; on those, port 20h bit 0 selects 15 MHz. A plain
; 83+ has no port 20h (it mirrors the link port there), so it is left alone. The OS goes
; back to 6 MHz itself when the program returns (design.md item 16).
	in a,(2)
	rla				; bit 7 → carry
	jr nc,SlowModel
	ld a,1
	out (20h),a
SlowModel:

; Read the parameters (GV gives 0 for a missing variable); GVBelow ends with bad input for a
; value that is too big
	ld a,'E'
	ld c,4
	call GVBelow			; E = 0-3
	cp 3				; E=3 is a separate job: list the notes
	jp z,ListNotes
	or a
	jp z,BadInput
	ld (Source),a
	ld a,'V'
	ld c,12
	call GVBelow
	ld (Version),a
	ld a,'M'
	ld c,3
	call GVBelow
	ld (Mode),a

; Find the input. A missing one (or an archived one: the Axe engine's GetCalc doesn't open
; those either) is bad input.
	ld a,(Source)
	cp 2
	jr z,FindNote
	ld hl,NameStr1
	ld a,(hl)			; the type the name is for: string
	push af
	call FindVar
	pop bc				; B = that type
	jp c,BadInput
; A variable of another type is bad input too
	ld a,(hl)			; HL = its VAT entry: the type is in the low 5 bits
	and 1Fh
	cp b
	jp nz,BadInput
; DE = the size word (bytes), then the data
	ex de,hl
	ld c,(hl)
	inc hl
	ld b,(hl)
	inc hl
	ld (InputPtr),hl

; Str1: the size word gives bytes, but a character can be a two-byte token, so count the
; tokens. HL walks the string (from its first token), DE = the end, BC counts.
	ld e,l
	ld d,h
	add hl,bc
	ex de,hl
	ld bc,0
CountTokens:
	or a				; while HL < DE
	sbc hl,de
	add hl,de
	jr nc,Counted
	inc bc
	call NextToken
	jr CountTokens
Counted:
	ld (Length),bc
	jr Measured

; A note: NF opens the one named in Str2 and measures its text
FindNote:
	call NF
	jp c,BadInput
	ld (Length),hl
Measured:

; The check's answer is 2T+1 at most, so T ≤ 32765 keeps it below the error codes (65532 and
; up). Tested before the scan, which would take long on a huge note.
	ld a,(Version)
	or a
	jr nz,LengthOK
	ld hl,32765
	ld bc,(Length)
	or a
	sbc hl,bc
	jr nc,LengthOK
	ld hl,AnsTooLong
	jp Quit
LengthOK:

; Scan the text: always for a check (V=0), and for a draw in auto mode (M=0: no check told us
; the mode); otherwise the draw trusts the earlier check.
	ld a,(Version)
	or a
	jr z,Scan
	ld a,(Mode)
	or a
	jp nz,Scanned
Scan:
	ld hl,0
	ld (Pos),hl
	ld (BadPos),hl
	ld (NonAlnumPos),hl
	ld hl,(InputPtr)
	ld (ReadPtr),hl
ScanLoop:
	ld hl,(Pos)			; while Pos < Length
	ld de,(Length)
	or a
	sbc hl,de
	jr nc,ScanDone
	call CH				; A = the next character's ASCII code, 0 if none
	ld c,a
; The first character outside printable ASCII (32-126) and newline (10)
	ld hl,(BadPos)
	ld a,h
	or l
	jr nz,ScanAlnum
	ld a,c
	cp 10
	jr z,ScanAlnum
	sub 32				; 32-126 → 0-94; below 32 wraps around to 224 and up
	cp 95
	jr c,ScanAlnum
	ld hl,(Pos)
	ld (BadPos),hl
; The first one alphanumeric mode can't encode (no more testing after it)
ScanAlnum:
	ld hl,(NonAlnumPos)
	ld a,h
	or l
	jr nz,ScanLoop
	ld a,c
	call AV
	jr nc,ScanLoop
	ld hl,(Pos)
	ld (NonAlnumPos),hl
	jr ScanLoop
ScanDone:
; Forced alphanumeric: the first non-alphanumeric character is the problem
	ld a,(Mode)
	cp 2
	jr nz,NotForced
	ld hl,(NonAlnumPos)
	ld (BadPos),hl
NotForced:
; Auto: alphanumeric (2) if every character allowed it, else byte mode (1)
	or a
	jr nz,ModeKnown
	ld hl,(NonAlnumPos)
	ld a,h
	or l
	ld a,1
	jr nz,AutoByte
	inc a
AutoByte:
	ld (Mode),a
ModeKnown:
; A problem character: its position goes into B (only if B exists). A note in byte mode just
; warns (its bytes go out as calculator codes); anything else fails.
	ld hl,(BadPos)
	ld a,h
	or l
	jr z,Scanned
	call StoreB
	ld a,(Source)
	cp 2
	jr nz,BadChar
	ld a,(Mode)
	cp 1
	jr z,Scanned
BadChar:
	ld hl,AnsBadChar
	jp Quit
Scanned:

; Check only: 2T+1 if alphanumeric (Mode 2), 2T if byte mode (Mode 1)
	ld a,(Version)
	or a
	jr nz,Encode
	ld hl,(Length)
	add hl,hl
	ld a,(Mode)
	dec a
	ld e,a
	ld d,0
	add hl,de
	jp Quit

; ---------- a draw call: from here Mode is 1 (byte) or 2 (alphanumeric) ----------
Encode:
	ld a,'N'
	call GV
	ld (Count),hl
	ld a,'O'
	call GV
	ld (Skip),hl

; The version's data codewords, EC codewords per block and blocks (EC level L)
	ld a,(Version)
	dec a
	ld c,a
	ld b,0				; BC = V-1
	ld hl,DataWords
	add hl,bc
	add hl,bc
	ld e,(hl)
	inc hl
	ld d,(hl)
	ld (DataCount),de
	ld hl,ECTable
	add hl,bc
	ld a,(hl)
	ld (ECPerBlock),a
	ld hl,BlockTable
	add hl,bc
	ld a,(hl)
	ld (Blocks),a

; Clamp the skip and the count to the text. Count ≤ 468 only keeps a bad N from writing past
; L₁; keeping N within the version's capacity is the caller's job.
	ld hl,(Length)
	ld de,(Skip)
	or a
	sbc hl,de			; HL = T - θ
	jr nc,SkipOK
	add hl,de			; θ > T: skip to the end (HL+DE = T)
	ld (Skip),hl
	ld hl,0
SkipOK:
	ld de,(Count)
	or a				; N > T-θ: N = T-θ (sbc then add leaves HL, and the carry
	sbc hl,de			; of the comparison)
	add hl,de
	jr nc,CountFits
	ld (Count),hl
CountFits:
	ld hl,(Count)
	ld de,469
	or a
	sbc hl,de
	jr c,CountOK
	ld hl,468
	ld (Count),hl
CountOK:

; Bit-pack the data codewords into L₁ with AB
	ld hl,DataOut
	ld (OutPtr),hl
	xor a
	ld (BitAcc),a
	ld (BitCount),a
; Mode indicator, 4 bits: 0100 byte mode, 0010 alphanumeric
	ld a,(Mode)
	cp 1
	ld hl,4
	jr z,ModeBits
	ld l,2
ModeBits:
	ld b,4
	call AB
; The character count; its width from CountWidths: byte v1-9, v10+, alphanumeric v1-9, v10+
	ld a,(Mode)
	dec a
	add a,a
	ld c,a
	ld a,(Version)
	cp 10
	jr c,CountWidth
	inc c
CountWidth:
	ld b,0
	ld hl,CountWidths
	add hl,bc
	ld b,(hl)
	ld hl,(Count)
	call AB

; Skip θ characters. A note: CH reads byte Pos+24 next, so setting Pos is enough. Str1: step
; over θ tokens by their length (no table lookup needed).
PackText:
	ld hl,(Skip)
	ld (Pos),hl
	ld a,(Source)
	cp 2
	jr z,TextReady
	ld b,h
	ld c,l
	ld hl,(InputPtr)
SkipTokens:
	ld a,b
	or c
	jr z,Skipped
	call NextToken
	dec bc
	jr SkipTokens
Skipped:
	ld (ReadPtr),hl
TextReady:
	ld a,(Mode)
	cp 2
	jr z,PackAlnum

; Byte mode: 8 bits per character
	ld bc,(Count)
PackBytes:
	ld a,b
	or c
	jr z,Packed
	push bc
	call CH
	ld l,a
	ld h,0
	ld b,8
	call AB
	pop bc
	dec bc
	jr PackBytes

; Alphanumeric: each pair as 45·first+second in 11 bits...
PackAlnum:
	ld hl,(Count)
	srl h
	rr l
	ld b,h
	ld c,l				; BC = pairs
PackPairs:
	ld a,b
	or c
	jr z,PackOdd
	push bc
	call CH
	call AV
	ld l,a				; HL = 45·value, as 9·(5·value)
	ld h,0
	ld d,h
	ld e,l
	add hl,hl
	add hl,hl
	add hl,de
	ld d,h
	ld e,l
	add hl,hl
	add hl,hl
	add hl,hl
	add hl,de
	push hl
	call CH
	call AV
	pop hl
	ld e,a
	ld d,0
	add hl,de
	ld b,11
	call AB
	pop bc
	dec bc
	jr PackPairs
; ...and an odd last character in 6 bits
PackOdd:
	ld a,(Count)
	rra
	jr nc,Packed
	call CH
	call AV
	ld l,a
	ld h,0
	ld b,6
	call AB
Packed:

; Terminator: up to 4 zero bits, fewer if the data is full. Bits left = 8M - bits written
; ((OutPtr-L₁)·8 + BitCount); like the Axe engine's, the subtraction wraps around if a bad N
; overfilled the version, which then counts as "more than 4 left".
	ld hl,(OutPtr)
	ld de,DataOut
	or a
	sbc hl,de
	add hl,hl
	add hl,hl
	add hl,hl
	ld a,(BitCount)
	ld e,a
	ld d,0
	add hl,de
	ex de,hl			; DE = bits written
	ld hl,(DataCount)
	add hl,hl
	add hl,hl
	add hl,hl
	or a
	sbc hl,de			; HL = bits left
	ld a,h
	or a
	jr nz,Term4
	ld a,l
	cp 5
	jr c,TermBits
Term4:
	ld a,4
TermBits:
	or a
	jr z,Terminated
	ld b,a
	ld hl,0
	call AB
Terminated:
; Zero bits up to the next byte boundary
	ld a,(BitCount)
	or a
	jr z,Aligned
	ld b,a
	ld a,8
	sub b
	ld b,a
	ld hl,0
	call AB
Aligned:
; Fill the rest with pad bytes 236 (ECh) and 17 (11h) in turn: 236 xor 253 = 17, and back
	ld hl,(DataCount)
	ld de,DataOut
	add hl,de
	ex de,hl			; DE = the end of the data codewords
	ld hl,(OutPtr)
	ld c,236
Pad:
	or a
	sbc hl,de
	add hl,de
	jr nc,Padded
	ld (hl),c
	inc hl
	ld a,c
	xor 253
	ld c,a
	jr Pad
Padded:

; ---------- error correction ----------

	call GFTables			; exp and log tables in L₃

; Generator polynomial (x-2⁰)(x-2¹)...(x-2^(R-1)), coefficients from the highest power down;
; Gen+0 stays 1. Start with 1, then multiply by (x+2^I) for each I: from the top down,
; coefficient J ^= coefficient J-1 · 2^I (that product done with logs: exp(log C + I)).
	ld a,(ECPerBlock)
	ld b,a
	ld hl,Gen+1
GenClear:
	ld (hl),0
	inc hl
	djnz GenClear
	ld hl,Gen
	ld (hl),1
	ld c,0				; C = I
GenFactor:
	ld hl,Gen+1
	ld e,c
	ld d,0
	add hl,de			; HL = coefficient J = I+1
	ld b,c
	inc b				; B = J, counting down to 1
GenTerm:
	dec hl
	ld a,(hl)			; coefficient J-1
	inc hl
	or a
	jr z,GenNext
	push hl
	ld l,a
	ld h,0
	ld de,LogTable
	add hl,de
	ld l,(hl)			; log C, plus I (at most 254 + 29)
	ld h,0
	ld e,c
	ld d,0
	add hl,de
	ld de,ExpTable
	add hl,de
	ld a,(hl)
	pop hl
	xor (hl)
	ld (hl),a
GenNext:
	dec hl
	djnz GenTerm
	inc c
	ld a,(ECPerBlock)
	cp c
	jr nz,GenFactor
; Store coefficients 1..R as logs, which is what RS uses (none of them is 0 for R ≤ 30, so
; every log exists)
	ld hl,Gen+1
	ld a,(ECPerBlock)
	ld b,a
GenLogs:
	ld e,(hl)
	ld d,0
	push hl
	ld hl,LogTable
	add hl,de
	ld a,(hl)
	pop hl
	ld (hl),a
	inc hl
	djnz GenLogs

; EC codewords for each block, R per block, from ECOut. Blocks are M/B long; the last M mod
; B are one byte longer. B is 1, 2 or 4, so the division counts subtractions.
	ld hl,(DataCount)
	ld a,(Blocks)
	ld e,a
	ld d,0
	ld bc,0
BlockDiv:
	or a
	sbc hl,de
	jr c,BlockDivDone
	inc bc
	jr BlockDiv
BlockDivDone:
	add hl,de
	ld a,c
	ld (ShortLen),a
	ld a,l
	ld (LongBlocks),a
	ld hl,DataOut
	ld (BlockPtr),hl
	ld hl,ECOut
	ld (ECPtr),hl
	ld a,(Blocks)
	ld b,a				; B = blocks left, including this one
ECBlock:
	push bc
	ld a,(LongBlocks)		; a long block when blocks left ≤ M mod B
	cp b
	ld a,(ShortLen)
	jr c,ECShort
	inc a
ECShort:
	ld c,a
	call RS
	pop bc
	djnz ECBlock

; ---------- drawing ----------

; S = 4V+17 modules a side; RowOff and ColOff center the symbol on the 96×64 screen (row 31,
; column 47 in the middle)
	ld a,(Version)
	add a,a
	add a,a
	add a,17
	ld (Size),a
	srl a
	ld b,a
	ld a,31
	sub b
	ld (RowOff),a
	ld a,47
	sub b
	ld (ColOff),a
; Both buffers cleared: the graph buffer for the drawing, L₃ (the GF tables are done with)
; for the map
	ld hl,plotSScreen
	call Clear768
	ld hl,Map
	call Clear768

; The map of the function modules: a set pixel = not a data module. The three finders with
; their separators and format areas, the timing row and column, and for v7+ the two version
; information blocks. Alignment patterns are added by AP below. (Rect: column B, row C,
; width D, height E.)
	ld ix,Map
	ld bc,0000h
	ld de,0909h
	call RectOn
	ld a,(Size)
	sub 8
	ld b,a
	ld c,0
	ld de,0809h
	call RectOn
	ld b,0
	ld a,(Size)
	sub 8
	ld c,a
	ld de,0908h
	call RectOn
	ld bc,0006h
	ld a,(Size)
	ld d,a
	ld e,1
	call RectOn
	ld bc,0600h
	ld d,1
	ld a,(Size)
	ld e,a
	call RectOn
	ld a,(Version)
	cp 7
	jr c,MapDone
	ld a,(Size)
	sub 11
	ld b,a
	ld c,0
	ld de,0306h
	call RectOn
	ld b,0
	ld a,(Size)
	sub 11
	ld c,a
	ld de,0603h
	call RectOn
MapDone:

; Finder patterns at the top left, top right and bottom left
	ld bc,0000h
	call FP
	ld a,(Size)
	sub 7
	ld b,a
	ld c,0
	call FP
	ld b,0
	ld a,(Size)
	sub 7
	ld c,a
	call FP

; Timing patterns: row 6 and column 6, dark at the even positions between the separators,
; 8 to S-9: that is 2V+1 modules each way
	ld a,(Version)
	add a,a
	inc a
	ld b,a
	ld a,8
Timing:
	push bc
	push af
	ld b,a
	ld c,6
	call PlotModule
	pop af
	push af
	ld b,6
	ld c,a
	call PlotModule
	pop af
	pop bc
	add a,2
	djnz Timing

; Alignment patterns (v2+). Coordinates at Align: v2-6 {6, S-7}; v7-11 {6, middle, S-7}.
; Every pair of them gets a pattern except those that would overlap a finder: skip a pair
; with 6 in it unless the other coordinate is the middle (v2-6: only (S-7,S-7) is left; v7+:
; (6,6), (6,S-7) and (S-7,6) go).
	ld a,(Version)
	cp 2
	jr c,AlignDone
	ld hl,Align
	ld (hl),6
	inc hl
	ld b,a
	ld a,(Size)
	sub 7
	ld c,a				; C = S-7
	ld a,b
	cp 7
	jr nc,AlignThree
	xor a
	ld (AlignMid),a
	ld (hl),c
	ld a,2
	jr AlignCounted
AlignThree:
	ld a,(Size)
	dec a
	srl a
	ld (AlignMid),a
	ld (hl),a
	inc hl
	ld (hl),c
	ld a,3
AlignCounted:
	ld (AlignCount),a
	xor a
	ld (AlignX),a
AlignLoopX:
	xor a
	ld (AlignY),a
AlignLoopY:
	ld hl,Align
	ld a,(AlignX)
	ld e,a
	ld d,0
	add hl,de
	ld b,(hl)			; B = the column
	ld hl,Align
	ld a,(AlignY)
	ld e,a
	add hl,de
	ld c,(hl)			; C = the row
	ld a,(AlignMid)
	ld d,a
	ld a,b				; column 6 and the row isn't the middle: skip
	cp 6
	jr nz,AlignRow6
	ld a,c
	cp d
	jr nz,AlignNext
AlignRow6:
	ld a,c				; row 6 and the column isn't the middle: skip
	cp 6
	jr nz,AlignDraw
	ld a,b
	cp d
	jr nz,AlignNext
AlignDraw:
	call AP
AlignNext:
	ld hl,AlignCount
	ld a,(AlignY)
	inc a
	ld (AlignY),a
	cp (hl)
	jr nz,AlignLoopY
	ld a,(AlignX)
	inc a
	ld (AlignX),a
	cp (hl)
	jr nz,AlignLoopX
AlignDone:

; Format information (always EC L, mask 0) and the dark module, from FormatDark: 9 (column,
; row) pairs near the top left finder, then 3 values k drawn at (S-k,8) along the top right,
; then 7 drawn at (8,S-k) down the bottom left (the last is the dark module)
	ld hl,FormatDark
	ld b,9
FormatPairs:
	push bc
	ld b,(hl)
	inc hl
	ld c,(hl)
	inc hl
	push hl
	call PlotModule
	pop hl
	pop bc
	djnz FormatPairs
	ld b,3
FormatRow:
	push bc
	ld a,(Size)
	sub (hl)
	inc hl
	ld b,a
	ld c,8
	push hl
	call PlotModule
	pop hl
	pop bc
	djnz FormatRow
	ld b,7
FormatColumn:
	push bc
	ld a,(Size)
	sub (hl)
	inc hl
	ld c,a
	ld b,8
	push hl
	call PlotModule
	pop hl
	pop bc
	djnz FormatColumn

; Version information (v7+): 18 bits, lowest first. Bit I goes to column S-11+(I mod 3),
; row I/3 (the top right block) and to the transposed place (the bottom left block). The
; word is shifted right after each bit; bits 16 and 17 are 0, as the word runs out.
	ld a,(Version)
	cp 7
	jr c,VersionDone
	sub 7
	add a,a
	ld e,a
	ld d,0
	ld hl,VersionInfo
	add hl,de
	ld e,(hl)
	inc hl
	ld d,(hl)
	ld (VersionBits),de
	xor a
	ld (VersionIdx),a
VersionBit:
	ld hl,(VersionBits)
	srl h
	rr l
	ld (VersionBits),hl
	jr nc,VersionNext
	ld a,(VersionIdx)		; C = I/3, B = I mod 3, by counting down threes
	ld c,0
VersionDiv:
	cp 3
	jr c,VersionDivDone
	sub 3
	inc c
	jr VersionDiv
VersionDivDone:
	ld b,a
	ld a,(Size)
	sub 11
	add a,b
	ld b,a				; B = S-11 + I mod 3, C = I/3
	push bc
	call PlotModule
	pop bc
	ld a,b				; the transposed place
	ld b,c
	ld c,a
	call PlotModule
VersionNext:
	ld a,(VersionIdx)
	inc a
	ld (VersionIdx),a
	cp 18
	jr c,VersionBit
VersionDone:

; Data modules in the standard zigzag: column pairs from the right edge, the first going up,
; then down, and so on. The codewords come one at a time from CW. ShortBlocks, BlockShift,
; ShortTotal and ECTotal are set once here for CW.
	ld a,(LongBlocks)
	ld b,a
	ld a,(Blocks)
	sub b
	ld (ShortBlocks),a
	ld a,(Blocks)
	ld c,0
Log2Blocks:
	srl a
	jr c,Log2Done
	inc c
	jr Log2Blocks
Log2Done:
	ld a,c
	ld (BlockShift),a
	ld a,(ShortLen)
	ld l,a
	ld h,0
	call ShiftUp			; HL = ShortLen · blocks
	ld (ShortTotal),hl
	ld a,(ECPerBlock)
	ld l,a
	ld h,0
	call ShiftUp
	ld (ECTotal),hl
	ld hl,0
	ld (CWIndex),hl
	call CW
	ld (CWByte),a
	ld a,80h
	ld (CWBit),a
	xor a
	ld (ZigPair),a
ZigLoopPair:
	ld a,(Size)			; while the pair < S/2
	srl a
	ld b,a
	ld a,(ZigPair)
	cp b
	jr nc,ZigDone
	add a,a				; the right column: S-1-2·pair, moved left past the timing
	ld b,a				; column 6 once the pairs reach it
	ld a,(Size)
	dec a
	sub b
	cp 7
	jr nc,ZigColOK
	dec a
ZigColOK:
	ld (ZigCol),a
	xor a
	ld (ZigStep),a
ZigLoopStep:
	ld a,(ZigPair)			; odd pairs go down, even pairs go up
	rra
	ld a,(ZigStep)
	jr c,ZigDown
	ld b,a
	ld a,(Size)
	dec a
	sub b
ZigDown:
	ld c,a				; C = the row
	ld a,(ZigCol)
	ld b,a				; B = the right column, then the left one
	push bc
	call ZigModule
	pop bc
	dec b
	call ZigModule
	ld a,(ZigStep)
	inc a
	ld (ZigStep),a
	ld hl,Size
	cp (hl)
	jr nz,ZigLoopStep
	ld hl,ZigPair
	inc (hl)
	jr ZigLoopPair
ZigDone:
	bcall(_GrBufCpy)		; DispGraph
	ld hl,0
	jp Quit

; ---------- E=3: list the notes into Str3 ----------

; For prgmQR's pager: 8 characters a name, padded with space tokens, in alphabetical order
; (character codes: digits, then A-Z, then θ; a shorter name before a longer one that starts
; the same), then blank names up to the end of the last page of 5. The pager reads the 5
; names of a page that starts with a real name, so it never reads past Str3, and Str3 is no
; longer than that needs (0-32 bytes of padding). Ans = the number of notes. The names are
; gathered at L₁+8K first (NameList: at most 80, L₁+0..639, the first 80 found). VAT walk: entries go
; down from (progPtr) to (pTemp); the type in the low 5 bits at P, the data pointer at P-3
; (low) and P-4 (high), the flash page at P-5 (0 = RAM), the name length at P-6, the name
; from P-7 downward, the next entry at P-7-length.
ListNotes:
	xor a
	ld (ListCount),a
	ld hl,(progPtr)
	ld (ListPtr),hl
LS_Entry:
	ld hl,(ListPtr)			; while P > (pTemp)
	ld de,(pTemp)
	or a
	sbc hl,de
	jr z,LS_Done
	jr c,LS_Done
	add hl,de
; An appvar (15h) with a name of 1-8 characters, while fewer than 80 are listed
	ld a,(hl)
	and 1Fh
	cp AppVarObj
	jr nz,LS_Next
	ld de,-6
	add hl,de
	ld a,(hl)
	dec a
	cp 8
	jr nc,LS_Next
	ld a,(ListCount)
	cp 80
	jr nc,LS_Next
; Its slot at L₁+8K: 8 space tokens, and NC copies the name over them. It counts only if
; the name can be opened by name (NC) and the appvar is really a note (NH); otherwise the
; next one gets the slot.
	call BlankSlot
	ex de,hl
	call NC
	jr c,LS_Next
; NH wants what _ChkFindSym would give, which is just what the VAT entry holds: DE = the
; data pointer, B = the page
	ld hl,(ListPtr)
	ld de,-3
	add hl,de
	ld e,(hl)
	dec hl
	ld d,(hl)
	dec hl
	ld b,(hl)
	call NH
	jr c,LS_Next
	ld hl,ListCount
	inc (hl)
LS_Next:
	ld hl,(ListPtr)			; P = P-7-length
	ld de,-6
	add hl,de
	ld e,(hl)
	ld d,0
	dec hl
	or a
	sbc hl,de
	ld (ListPtr),hl
	jr LS_Entry

; Str3 = the names, sorted, and the blank names that end the last page. Enough free RAM is
; checked first (the string, its size word and VAT entry, and a margin), so a full calculator
; gets 65535 instead of the OS's ERR:MEMORY. An old Str3 is deleted first (making one that
; exists would make a second).
LS_Done:
	call SortNames
	ld a,(ListCount)
	ld c,a				; C = names so far, real and blank
LS_Round:
	ld a,c				; C mod 5: subtract 5s until it goes below 0, then add one back
LS_Mod5:
	sub 5
	jr nc,LS_Mod5
	add a,5
	jr z,LS_Rounded			; the last page is full
	ld a,c
	push bc
	call BlankSlot
	pop bc
	inc c
	jr LS_Round
LS_Rounded:
	ld a,c
	call NameAddr			; Str3's size = 8C: NameList + 8C, less NameList
	ld de,-NameList
	add hl,de
	ld (ListSize),hl
	bcall(_MemChk)			; HL = free RAM
	ld de,32
	or a
	sbc hl,de
	jp c,BadInput
	ld de,(ListSize)
	sbc hl,de
	jp c,BadInput
	ld hl,NameStr3
	call NameToOP1
	bcall(_ChkFindSym)
	jr c,LS_NoOld
	bcall(_DelVarArc)
LS_NoOld:
	ld hl,NameStr3
	call NameToOP1
	ld hl,(ListSize)
	bcall(_CreateStrng)		; DE = its size word
	inc de
	inc de
	ld bc,(ListSize)		; all the names, real and blank (none: nothing to copy)
	ld a,b
	or c
	jr z,LS_Copied
	ld hl,NameList
	ldir
LS_Copied:
	ld a,(ListCount)
	ld l,a
	ld h,0
	jr Quit

; ---------- leaving ----------

; BadInput: Ans = 65535 (bad E, V or M, or the input doesn't exist), and return.
BadInput:
	ld hl,AnsBadInput

; Quit: Ans = HL, and return to prgmQR from anywhere: the stack goes back to where it was at
; the start, so this works from inside subroutines too.
Quit:
	ld sp,(SaveSP)
	bcall(_SetXXXXOP2)		; OP2 = HL as a float
	bcall(_OP2ToOP1)
	bcall(_StoAns)
	ret

; ---------- subroutines ----------

; CH: the next character → A; adds 1 to Pos (the position of the character read).
; A note (Source 2): the text starts at byte 24 of the appvar, so the character is byte
; Pos+23, its calculator code mapped by MA (never 0: the text ends at the first 00h).
; Str1: A = the token's ASCII code, 0 if it has none, and ReadPtr moves past the token. A
; token is found in TokenFirst (95 first bytes, one per ASCII 32-126), or, for a two-byte
; token, its second byte in TokenSecond. Only BBh tokens have ASCII among the two-byte ones;
; BB 00 is npv(, never a character (0 in TokenSecond means a one-byte token).
; Changes AF, BC, DE, HL.
CH:
	ld hl,(Pos)
	inc hl
	ld (Pos),hl
	ld a,(Source)
	cp 2
	jr nz,CH_Str1
	ld de,23
	add hl,de
	call RB
	jp MA
CH_Str1:
	ld hl,(ReadPtr)
	ld a,(hl)
	inc hl
	ld e,a				; E = the first byte
	call IsPrefix
	jr nz,CH_OneByte
	ld d,(hl)			; D = the second byte
	inc hl
	ld (ReadPtr),hl
	ld a,e
	cp t2ByteTok
	jr nz,CH_None
	ld a,d
	or a
	jr z,CH_None
	ld hl,TokenSecond
	jr CH_Search
CH_OneByte:
	ld (ReadPtr),hl
	ld a,e
	ld hl,TokenFirst
CH_Search:
	ld bc,95
	cpir
	jr nz,CH_None
; found at row position 95-BC (1-95, cpir counted the match too): ASCII = 31 + that
	ld a,126
	sub c
	ret
CH_None:
	xor a
	ret

; AB: append the low B bits (1-16) of HL to the data codewords, highest first. HL is first
; shifted left so its first bit is bit 15; then each add hl,hl pushes the next bit into
; carry, and rla moves it into BitAcc (kept in A), whose old bits leave from the top. Every 8
; bits A is stored at OutPtr. Changes AF, BC, DE, HL.
AB:
	ld a,16
	sub b
	jr z,AB_Ready
AB_Align:
	add hl,hl
	dec a
	jr nz,AB_Align
AB_Ready:
	ld de,(OutPtr)
	ld a,(BitCount)
	ld c,a
	ld a,(BitAcc)
AB_Bit:
	add hl,hl
	rla
	inc c
	bit 3,c				; 8 bits?
	jr z,AB_Next
	ld (de),a
	inc de
	ld c,0
AB_Next:
	djnz AB_Bit
	ld (OutPtr),de
	ld (BitAcc),a
	ld a,c
	ld (BitCount),a
	ret

; RS: the R EC codewords of one block of C data codewords (C ≥ 1) at BlockPtr, written at
; ECPtr; then both pointers move past what they cover. Polynomial division done like a shift
; register: the remainder (R bytes, plus a 0 byte that shifts in) at Rem. For each data byte:
; F = byte xor the remainder's first byte; shift the remainder left one byte; then remainder
; ^= F · generator (coefficients 1..R, stored as logs: F·g = exp(log F + log g)).
; Changes AF, BC, DE, HL.
RS:
	ld hl,Rem
	ld a,(ECPerBlock)
	inc a
	ld b,a
RS_Clear:
	ld (hl),0
	inc hl
	djnz RS_Clear
	ld de,(BlockPtr)
RS_Byte:
	ld a,(de)
	inc de
	push de
	push bc
	ld hl,Rem
	xor (hl)			; F, and Z if it is 0
	push af
	ld de,Rem			; shift the remainder left
	ld hl,Rem+1
	ld a,(ECPerBlock)
	ld c,a
	ld b,0
	ldir
	pop af
	jr z,RS_Next
	ld l,a
	ld h,0
	ld de,LogTable
	add hl,de
	ld c,(hl)			; C = log F
	ld a,(ECPerBlock)
	ld b,a
	ld hl,Gen+1
	ld de,Rem
RS_Term:
	ld a,(hl)			; log g + log F: up to 508, so the carry is bit 8
	add a,c
	push hl
	ld l,a
	ld h,0
	rl h
	push de
	ld de,ExpTable
	add hl,de
	pop de
	ld a,(de)
	xor (hl)
	ld (de),a
	inc de
	pop hl
	inc hl
	djnz RS_Term
RS_Next:
	pop bc
	pop de
	dec c
	jr nz,RS_Byte
	ld (BlockPtr),de
	ld de,(ECPtr)
	ld hl,Rem
	ld a,(ECPerBlock)
	ld c,a
	ld b,0
	ldir
	ld (ECPtr),de
	ret

; CW: codeword CWIndex of the final (interleaved) sequence → A, read in place. The order is:
; data byte 0 of every block, byte 1 of every block, ...; then the last byte of each long
; block; then EC byte 0 of every block, byte 1, ...; then 0 (the remainder bits after the
; last codeword). The block count is 1, 2 or 4, so "mod blocks" is an and and "/ blocks" a
; shift (BlockShift). Changes AF, BC, DE, HL.
CW:
	ld hl,(CWIndex)
	ld de,(DataCount)
	or a
	sbc hl,de
	jr nc,CW_EC
	add hl,de			; HL = Q, a data codeword
	ld de,(ShortTotal)
	or a
	sbc hl,de
	jr nc,CW_Extra
	add hl,de
	ld a,(Blocks)			; block Q mod B, index Q / B in it
	dec a
	and l
	ld c,a
	call ShiftDown
	jr CW_Data
CW_Extra:
	ld a,(ShortBlocks)		; past ShortTotal: the extra last bytes of the long blocks
	add a,l
	ld c,a				; block ShortBlocks + (Q - ShortTotal)
	ld a,(ShortLen)
	ld l,a				; index ShortLen
	ld h,0
CW_Data:
; block C starts at C·ShortLen, plus 1 for each long block before it (C - ShortBlocks if
; that is positive); HL = the index in the block
	ld a,(ShortBlocks)
	ld b,a
	ld a,c
	sub b
	jr c,CW_NoLong
	ld e,a
	ld d,0
	add hl,de
CW_NoLong:
	ld a,(ShortLen)
	ld e,a
	ld d,0
	ld b,c
	inc b
	jr CW_MulTest
CW_Mul:
	add hl,de
CW_MulTest:
	djnz CW_Mul
	ld de,DataOut
	add hl,de
	ld a,(hl)
	ret
; EC byte (Q-M) / B of block (Q-M) mod B; the blocks' EC codewords are R apart
CW_EC:
	ld de,(ECTotal)
	or a
	sbc hl,de
	jr nc,CW_Zero
	add hl,de
	ld a,(Blocks)
	dec a
	and l
	ld c,a
	call ShiftDown
	ld a,(ECPerBlock)
	ld e,a
	ld d,0
	ld b,c
	inc b
	jr CW_ECTest
CW_ECMul:
	add hl,de
CW_ECTest:
	djnz CW_ECMul
	ld de,ECOut
	add hl,de
	ld a,(hl)
	ret
CW_Zero:
	xor a
	ret

; ShiftDown: HL / blocks; ShiftUp: HL · blocks (shifts by BlockShift). Change AF, B, HL.
ShiftDown:
	ld a,(BlockShift)
	or a
	ret z
	ld b,a
SD_Loop:
	srl h
	rr l
	djnz SD_Loop
	ret
ShiftUp:
	ld a,(BlockShift)
	or a
	ret z
	ld b,a
SU_Loop:
	add hl,hl
	djnz SU_Loop
	ret

; ZigModule: the module at column B, row C (module coordinates), if it is a data module (not
; set in the map): Mask 0 inverts a bit where column+row is even, so the module is dark iff
; its bit equals (column+row) mod 2. Then the next bit; after 8, the next codeword.
; Changes AF, BC, DE, HL.
ZigModule:
	push bc
	ld de,Map
	call PixelAddr
	and (hl)
	pop bc
	ret nz				; a function module
	ld a,b
	add a,c
	and 1
	ld d,a				; D = (column+row) mod 2
	ld a,(CWByte)
	ld hl,CWBit
	and (hl)
	jr z,ZM_Bit
	ld a,1				; A = the bit
ZM_Bit:
	cp d
	call z,PlotModule
	ld hl,CWBit
	srl (hl)
	ret nz
	ld (hl),80h
	ld hl,(CWIndex)
	inc hl
	ld (CWIndex),hl
	call CW
	ld (CWByte),a
	ret

; FP: a finder pattern with its top left module at column B, row C: a 7×7 dark square, the
; 5×5 inside inverted (cleared), a 3×3 dark center. Changes AF, BC, DE, HL, IX.
FP:
	call ToScreen
	ld ix,plotSScreen
	push bc
	ld de,0707h
	call RectOn
	pop bc
	inc b
	inc c
	push bc
	ld de,0505h
	call RectInv
	pop bc
	inc b
	inc c
	ld de,0303h
	jp RectOn

; AP: an alignment pattern centered at column B, row C: marked in the map (no offset), then
; drawn: 5×5 dark, the 3×3 inside cleared (inverted), the center dark. It draws its own light
; modules, so it doesn't matter that the timing pattern was drawn first.
; Changes AF, BC, DE, HL, IX.
AP:
	dec b
	dec b
	dec c
	dec c				; the top left corner
	push bc
	ld ix,Map
	ld de,0505h
	call RectOn
	pop bc
	call ToScreen
	ld ix,plotSScreen
	push bc
	ld de,0505h
	call RectOn
	pop bc
	inc b
	inc c
	push bc
	ld de,0303h
	call RectInv
	pop bc
	inc b
	inc c
	jr PlotOn

; ToScreen: module column B, row C → screen column B+ColOff, row C+RowOff. Changes AF.
ToScreen:
	ld a,(ColOff)
	add a,b
	ld b,a
	ld a,(RowOff)
	add a,c
	ld c,a
	ret

; PlotModule: the module at column B, row C dark (in the graph buffer, offset to the screen);
; PlotOn: the same at screen column B, row C. PlotModule changes AF, BC (to the screen
; position), DE, HL; PlotOn keeps BC.
PlotModule:
	call ToScreen
PlotOn:
	ld de,plotSScreen
	call PixelAddr
	or (hl)
	ld (hl),a
	ret

; PixelAddr: column B (0-95), row C (0-63) of the 96×64 buffer at DE → HL = its byte (12 a
; row), A = its bit (80h for the leftmost column of the byte). Changes AF, DE, HL.
PixelAddr:
	push de
	ld l,c
	ld h,0
	ld d,h
	ld e,l
	add hl,hl
	add hl,de
	add hl,hl
	add hl,hl			; 12·row
	ld a,b
	srl a
	srl a
	srl a
	ld e,a
	ld d,0
	add hl,de			; + column / 8
	pop de
	add hl,de
	ld a,b
	and 7
	ld d,a
	inc d
	ld a,80h
PA_Shift:
	dec d
	ret z
	rrca
	jr PA_Shift

; RectOn fills, RectInv inverts, the rectangle D wide and E high (both ≥ 1) with its top left
; at column B, row C of the 96×64 buffer at IX. Changes AF, BC, DE, HL.
RectOn:
	xor a
	jr Rect
RectInv:
	ld a,1
Rect:
	ld (RectOp),a
Rect_Row:
	push bc
	push de
Rect_Col:
	push de
	push ix
	pop de
	call PixelAddr
	ld e,a
	ld a,(RectOp)
	or a
	ld a,(hl)
	jr nz,Rect_Invert
	or e
	jr Rect_Store
Rect_Invert:
	xor e
Rect_Store:
	ld (hl),a
	pop de
	inc b
	dec d
	jr nz,Rect_Col
	pop de
	pop bc
	inc c
	dec e
	jr nz,Rect_Row
	ret

; Clear768: 768 zero bytes from HL (a 96×64 buffer). Changes BC, DE, HL.
Clear768:
	ld (hl),0
	ld d,h
	ld e,l
	inc de
	ld bc,767
	ldir
	ret

; GFTables: the GF(256) tables in L₃ (field polynomial 11Dh): exp twice, then log. C = 2^I
; as I goes 0-254; doubling past 8 bits drops bit 8 (the carry) and xors with 1Dh (11Dh's
; low byte). Changes AF, BC, DE, HL.
GFTables:
	ld hl,ExpTable
	ld c,1
	ld b,0
GFLoop:
	ld (hl),c			; exp[I]
	push hl
	ld de,255
	add hl,de
	ld (hl),c			; exp[I+255]
	ld hl,LogTable
	ld e,c
	ld d,0
	add hl,de
	ld (hl),b			; log[C] = I
	pop hl
	inc hl
	ld a,c
	add a,a
	jr nc,GFNoCarry
	xor 1Dh
GFNoCarry:
	ld c,a
	inc b
	ld a,b
	cp 255
	jr nz,GFLoop
	ret

; MA: calculator character code C → output byte A. Most go out unchanged; the calculator's
; swaps are undone so a character never poses as another ASCII one: θ (5Bh) and [ (C1h)
; swap, ⁴ (24h) and $ (F2h) swap, Enter (D6h) and 0Ah swap, F1h (the space where a line
; wrapped) → space, D2h (hyphen) → -. The negative sign (1Ah) isn't ASCII, so it stays.
; Changes AF, BC, HL.
MA:
	ld a,c
	ld hl,SwapFrom
	ld bc,8
	cpir
	ret nz
	ld hl,SwapTo+7			; found at position 8-BC (1-8): its pair is at SwapTo+7-BC
	or a
	sbc hl,bc
	ld a,(hl)
	ret

; NF: open the note named in Str2: carry if there is none (no Str2, a name that isn't 1-8
; characters, no such appvar, or not a note); else HL = its text length [T] and NH has set
; NotePage, NoteAddr and NoteSize. The name ends at the first space token or at the end of
; Str2; it goes to AppvarName as an OP1 name, 15h, the name, 0. Changes everything.
NF:
	ld hl,NameStr2
	call FindVar
	ret c
	ex de,hl
	ld c,(hl)
	inc hl
	ld b,(hl)
	inc hl				; BC = Str2's size, HL = its first token
	ld de,AppvarName+1
	ld a,1				; A = 1 + the characters copied
NF_Copy:
	push af
	ld a,b
	or c
	jr z,NF_Copied
	ld a,(hl)
	cp tSpace
	jr z,NF_Copied
	pop af
	cp 9				; a 9th character: too long (stop here, not after L₁)
	jr z,NF_Fail
	push af
	ld a,(hl)
	ld (de),a
	inc de
	inc hl
	dec bc
	pop af
	inc a
	jr NF_Copy
NF_Copied:
	pop af
	dec a				; 0 characters: no name
	jr z,NF_Fail
	xor a
	ld (de),a
	ld hl,AppvarName
	ld (hl),AppVarObj
	ld de,OP1
	ld bc,10
	ldir
	bcall(_ChkFindSym)
	ret c
	call NH
	ret c
; The text runs from byte 24 to a 00h; the appvar size bounds it (size-24 bytes at most, 3 or
; more since NH wants 27)
	ld hl,(NoteSize)
	ld de,-24
	add hl,de
	ld b,h
	ld c,l
	jp NoteTextLen			; HL = the length, no carry
NF_Fail:
	scf
	ret

; NoteTextLen: the open note's text length → HL: the bytes from byte 24 up to the first 00h,
; but at most BC of them (BC ≥ 1; BC if there is no 00h before). Read without OS calls: a
; note in RAM with one cpir; one in flash with its page mapped into bank A (4000h-7FFFh)
; through port 6, going on to the next page at 8000h, and the page that was there put back
; at the end. Changes AF, BC, DE, HL.
NoteTextLen:
	push bc				; the limit, for the answer
	push bc
	ld hl,24
	call NotePtr			; B = the page (0 = RAM), HL = the address of byte 24
	ld a,b
	pop bc				; BC = bytes left to look at
	or a
	jr nz,TL_Flash
	cpir				; A = 0: Z if it found the 00h
	jr TL_End
TL_Flash:
	ld d,a				; D = the page
	in a,(6)
	ld e,a				; E = the page bank A had, put back at the end
TL_Map:
	ld a,d
	out (6),a
	xor a
TL_Byte:
	cpi				; compare with 00h, HL+1, BC-1: Z for the 00h, PO when BC = 0
	jr z,TL_Unmap
	jp po,TL_NoZero
	bit 7,h				; still below 8000h: the same page
	jr z,TL_Byte
	ld h,40h			; the next page, from its start
	inc d
	jr TL_Map
TL_NoZero:
	inc a				; NZ: no 00h (A was 0)
TL_Unmap:
	ld a,e				; (ld and out leave the flags alone)
	out (6),a
TL_End:
	jr nz,TL_Length
	inc bc				; found: BC counted the bytes after the 00h, not the 00h
TL_Length:
	pop hl
	or a
	sbc hl,bc			; the limit minus what was left (never negative: no carry)
	ret

; NH: after _ChkFindSym found the appvar (B = its page, DE = its data in RAM or its archive
; entry in flash): set NotePage, NoteAddr (its data, after the size word) and NoteSize; carry
; if it isn't a note (smaller than 27 bytes, or no NoteFolio signature).
; An archive entry: FCh, a size word, the VAT entry's 6 bytes, the name length (byte 9), the
; name, then the data: the size word at 10 + the name length. Changes AF, BC, DE, HL.
NH:
	ld a,b
	ld (NotePage),a
	or a
	jr nz,NH_Flash
	ex de,hl
	ld e,(hl)
	inc hl
	ld d,(hl)
	inc hl
	ld (NoteAddr),hl
	ld (NoteSize),de
	jr NH_Check
NH_Flash:
	ld hl,-4000h
	add hl,de
	ld (NoteAddr),hl		; the entry, as an offset from 4000h on NotePage
	ld hl,9
	call RB				; C = the name length
	ld l,c
	ld h,0
	ld de,10
	add hl,de
	call NoteSeek			; now at the size word
	ld hl,0
	call RB
	push bc
	ld hl,1
	call RB
	pop de
	ld d,c
	ld (NoteSize),de
	ld hl,2
	call NoteSeek			; now at the data
NH_Check:
	ld hl,(NoteSize)
	ld de,27
	or a
	sbc hl,de
	ret c
; The first 4 bytes must be the NoteFolio signature
	ld hl,0
NH_Signature:
	push hl
	call RB
	pop hl
	push hl
	ld de,Signature
	add hl,de
	ld a,(hl)
	pop hl
	cp c
	scf
	ret nz
	inc hl
	ld a,l
	cp 4
	jr nz,NH_Signature
	or a
	ret

; RB: byte HL of the open note's data → C: from RAM, or from flash with its page mapped into
; bank A (port 6) for the one read and the old page put back. That is what _LoadCIndPaged
; does, without a bcall's cost on every byte; Axe reads archived files the same way, with
; interrupts on. Changes AF, B, DE, HL.
RB:
	call NotePtr
	ld a,b
	or a
	jr nz,RB_Flash
	ld c,(hl)
	ret
RB_Flash:
	in a,(6)
	ld e,a				; E = the page bank A has now
	ld a,b
	out (6),a
	ld c,(hl)
	ld a,e
	out (6),a
	ret

; NoteSeek: move NoteAddr (and NotePage) HL bytes on. Changes AF, B, DE, HL.
NoteSeek:
	call NotePtr
	ld a,b
	ld (NotePage),a
	or a
	jr z,NS_RAM
	res 6,h				; back to an offset from 4000h
NS_RAM:
	ld (NoteAddr),hl
	ret

; NotePtr: where byte HL of the open note's data is: B = 0 and HL = the address in RAM, or
; B = the flash page and HL = the address (4000h-7FFFh). In flash, NoteAddr + HL can pass a
; 16 KB page, even several (a note can be 32 KB, so the sum can need 17 bits): the page goes
; up by the sum's bits 14 and up, and the address keeps bits 0-13. Changes AF, B, DE, HL.
NotePtr:
	ld de,(NoteAddr)
	add hl,de
	sbc a,a				; A = FFh if the sum carried out of 16 bits (bit 16)
	ld e,a
	ld a,(NotePage)
	ld b,a
	or a
	ret z				; RAM: B = 0, HL = the address
	ld a,e
	and 4				; bit 16 = 4 pages
	ld e,a
	ld a,h
	rlca
	rlca
	and 3				; bits 14-15
	add a,e
	add a,b
	ld b,a
	ld a,h
	and 3Fh
	or 40h
	ld h,a
	ret

; NC: copy the VAT name of the entry at ListPtr (its length at P-6, the name from P-7 down)
; to DE. Carry unless every character is 0-9, A-Z or θ (5Bh, the 27th "letter"): those are
; also their own tokens, so prgmQR can show the name and pass it back in Str2.
; Changes AF, BC, DE, HL.
NC:
	ld hl,(ListPtr)
	ld bc,-6
	add hl,bc
	ld b,(hl)			; B = the length (1-8)
	dec hl
	ld c,0				; C = 1 once a character fails
NC_Char:
	ld a,(hl)
	ld (de),a
	inc de
	dec hl
	sub '0'				; 0-9, or A-Z and θ (A-θ = 41h-5Bh)
	cp 10
	jr c,NC_OK
	sub 'A'-'0'
	cp 27
	jr c,NC_OK
	ld c,1
NC_OK:
	djnz NC_Char
	ld a,c
	rra				; carry = a character failed
	ret

; SortNames: sort the ListCount names at NameList (8 bytes each) by insertion sort: each name
; in turn goes to SortBuf, the names before it that sort after it move up a slot, and it
; goes into the gap. At most 80 names, so at most 3160 comparisons. Changes AF, BC, DE, HL.
SortNames:
	ld a,(ListCount)
	cp 2
	ret c
	ld c,1				; C = the name to place
SN_Take:
	ld a,c
	call NameAddr
	ld de,SortBuf
	push bc
	ld bc,8
	ldir
	pop bc
	ld b,c				; B = its slot so far
SN_Compare:
	ld a,b
	dec a
	call NameAddr			; HL = the name in the slot before
	push hl
	push bc
	ld de,SortBuf
	call Cmp8			; carry: SortBuf sorts before it
	pop bc
	pop hl
	jr nc,SN_Place
	push bc				; move it up a slot
	ld d,h
	ld e,l
	ex de,hl
	ld bc,8
	add hl,bc
	ex de,hl			; DE = HL + 8
	ldir
	pop bc
	djnz SN_Compare			; B = 0: it goes first
SN_Place:
	ld a,b
	call NameAddr
	ex de,hl
	ld hl,SortBuf
	push bc
	ld bc,8
	ldir
	pop bc
	inc c
	ld a,(ListCount)
	cp c
	jr nz,SN_Take
	ret

; Cmp8: compare the 8-byte names at DE and HL, character by character: carry if DE's sorts
; before HL's (Z if they are the same). The padding space (29h) is below every character a
; name can have, so a shorter name sorts first. Changes AF, B, DE, HL.
Cmp8:
	ld b,8
C8_Char:
	ld a,(de)
	cp (hl)
	ret nz
	inc de
	inc hl
	djnz C8_Char
	ret

; BlankSlot: name A's slot (HL = NameList + 8A) filled with 8 space tokens. Changes BC, DE.
BlankSlot:
	call NameAddr
	push hl
	ld (hl),tSpace
	ld d,h
	ld e,l
	inc de
	ld bc,7
	ldir
	pop hl
	ret

; NameAddr: HL = NameList + 8A, name A's slot. Changes DE, HL.
NameAddr:
	ld l,a
	ld h,0
	add hl,hl
	add hl,hl
	add hl,hl
	ld de,NameList
	add hl,de
	ret

; NameToOP1: copy a 9-byte OS name from HL to OP1. Changes BC, DE, HL.
NameToOP1:
	ld de,OP1
	ld bc,9
	ldir
	ret

; NextToken: HL past the token at HL (one byte, or two after a prefix byte). Changes AF.
NextToken:
	ld a,(hl)
	inc hl
	call IsPrefix
	ret nz
	inc hl
	ret

; IsPrefix: Z if A is the first byte of a two-byte token. Changes F.
IsPrefix:
	push bc
	push hl
	ld hl,Prefixes
	ld bc,11
	cpir
	pop hl
	pop bc
	ret

; AV: ASCII A → its alphanumeric value in A (0-9 digits, 10-35 A-Z, 36-44 space $ % * + - .
; / :), carry clear; carry set if alphanumeric mode has none. The subtractions wrap around
; below 0 (a code below '0' becomes a large number), and adding 'A' back undoes them, so A is
; the ASCII code again when it reaches the punctuation table. Changes AF, BC, HL.
AV:
	sub '0'
	cp 10
	jr c,AV_OK			; 0-9
	sub 'A'-'0'
	cp 26
	jr nc,AV_Punct
	add a,10			; A-Z → 10-35
AV_OK:
	or a
	ret
AV_Punct:
	add a,'A'
	ld hl,Punct
	ld bc,9
	cpir
	scf
	ret nz
; found at position 9-BC (1-9): value 35 + that
	ld a,44
	sub c
	ret

; GVBelow: the OS real variable named A (GV) → A, which must be below C (at most 255), else
; the program ends with bad input. A value above 255 can't be valid, so it is refused before
; it is cut to a byte (V=256 must not read as 0). Changes AF, BC, DE, HL, OP1.
GVBelow:
	push bc
	call GV
	pop bc
	ld a,h
	or a
	jp nz,BadInput
	ld a,l
	cp c
	jp nc,BadInput
	ret

; GV: the OS real variable named A ('E', 'V', ...) → HL as an integer (FloatToInt), 0 if it
; doesn't exist or is archived. Changes AF, BC, DE, HL, OP1.
GV:
	call RealToOP1
	call FindOP1
	ld hl,0
	ret c
	; fall through: DE = the float

; FloatToInt: the 9-byte float at DE → HL, its integer part (the fraction is dropped). A
; negative number, or one of 65536 or more, gives 65535: every parameter rejects or clamps
; that. (Axe's float{ isn't documented for those, so this is a choice, not a copy.)
; The float: a sign byte (bit 7), the exponent byte (80h + the power of ten), then 14 BCD
; digits, two to a byte, the first being the units digit when the exponent is 80h. So the
; integer part is the first exponent-7Fh digits. Changes AF, BC, DE, HL.
FloatToInt:
	ld a,(de)
	rla				; sign → carry
	jr c,FTI_Max
	inc de
	ld a,(de)
	sub 80h				; A = the power of ten
	ld hl,0
	ret c				; below 1: 0
	cp 5
	jr nc,FTI_Max			; 100000 or more
	inc a
	ld b,a				; B = digits before the point, 1-5
	inc de				; the first pair of digits
	ld c,0				; C = 0 for the high digit of the byte, 1 for the low one
FTI_Digit:
	ld a,(de)
	bit 0,c
	jr nz,FTI_Low
	rrca
	rrca
	rrca
	rrca
FTI_Low:
	and 0Fh
	push de				; HL = 10·HL + A, any carry out of 16 bits is too big
	ld d,h
	ld e,l
	add hl,hl
	jr c,FTI_Over
	add hl,hl
	jr c,FTI_Over
	add hl,de			; ·5
	jr c,FTI_Over
	add hl,hl			; ·10
	jr c,FTI_Over
	ld e,a
	ld d,0
	add hl,de
	jr c,FTI_Over
	pop de
	ld a,c				; next digit: the low half of this byte, or the next byte
	xor 1
	ld c,a
	jr nz,FTI_Next
	inc de
FTI_Next:
	djnz FTI_Digit
	ret
FTI_Over:
	pop de
FTI_Max:
	ld hl,65535
	ret

; StoreB: B = HL (as a float), if a real variable B exists in RAM; nothing otherwise (the
; engine never creates variables). A complex B is left alone: a real's float in its first
; half would leave it half real. Changes AF, BC, DE, HL, OP1, OP2.
StoreB:
	push hl
	ld a,'B'
	call RealToOP1
	call FindOP1
	jr c,StoreB_None
	ld a,(hl)			; HL = its VAT entry: the type is in the low 5 bits
	and 1Fh
	jr nz,StoreB_None
	pop hl
	push de				; DE = its data
	bcall(_SetXXXXOP2)		; OP2 = HL as a float
	pop de
	ld hl,OP2
	ld bc,9
	ldir
	ret
StoreB_None:
	pop hl
	ret

; RealToOP1: OP1 = the name of the real variable A: type 0, the letter, 0, 0. Changes HL.
RealToOP1:
	ld hl,OP1
	ld (hl),RealObj
	inc hl
	ld (hl),a
	inc hl
	ld (hl),0
	inc hl
	ld (hl),0
	ret

; FindVar: find the OS variable whose name (9 bytes, OP1 style: type, name, zeros) is at HL.
; Carry set if it doesn't exist or is archived; else DE = its data (in RAM) and HL = its VAT
; entry. Changes AF, BC, DE, HL, OP1.
FindVar:
	ld de,OP1
	ld bc,9
	ldir
FindOP1:			; the same, with the name already in OP1
	bcall(_ChkFindSym)
	ret c
	ld a,b				; B = flash page, 0 in RAM
	or a
	ret z
	scf
	ret

; ---------- data ----------

NameStr1:	.db StrngObj, tVarStrng, tStr1, 0, 0, 0, 0, 0, 0
NameStr2:	.db StrngObj, tVarStrng, tStr2, 0, 0, 0, 0, 0, 0
NameStr3:	.db StrngObj, tVarStrng, tStr3, 0, 0, 0, 0, 0, 0

; The first 4 bytes of every NoteFolio appvar (GDB8)
Signature:	.db 0F3h, 047h, 0BFh, 0AFh
; Note characters that change on the way out ([ θ $ ⁴ Enter 0Ah, wrapped-line space, hyphen),
; and what each becomes (GDB9+10, GDB9+20; see MA)
SwapFrom:	.db 0C1h, 05Bh, 0F2h, 024h, 0D6h, 00Ah, 0F1h, 0D2h
SwapTo:		.db 05Bh, 0C1h, 024h, 0F2h, 00Ah, 0D6h, 020h, 02Dh

; Per version 1-11 at EC level L (GDB3, GDB4, GDB5): data codewords (words), EC codewords per
; block, blocks
DataWords:	.dw 19, 34, 55, 80, 108, 136, 156, 194, 232, 274, 324
ECTable:	.db 7, 10, 15, 20, 26, 18, 20, 24, 30, 18, 20
BlockTable:	.db 1, 1, 1, 1, 1, 2, 2, 2, 2, 4, 4
; Character count widths: byte mode v1-9, v10+, alphanumeric v1-9, v10+ (GDB5+11)
CountWidths:	.db 8, 16, 9, 11
; Version information for v7-11 (GDB6; words: 18-bit BCH codes whose top 2 bits are 0 for
; versions below 16, so 16 bits suffice)
VersionInfo:	.dw 07C94h, 085BCh, 09A99h, 0A4D3h, 0BBF6h
; The dark modules of the format information (GDB7). EC L and mask 0 always give 77C4h, so
; only the dark ones are listed: 9 (column,row) pairs near the top left finder, then 3 values
; k drawn at (S-k,8) and 7 values k drawn at (8,S-k); the last is the dark module that every
; QR code has, at (8,S-8)
FormatDark:	.db 8,2, 8,7, 8,8, 7,8, 5,8, 4,8, 2,8, 1,8, 0,8
		.db 3, 7, 8
		.db 7, 6, 5, 3, 2, 1, 8

; The first bytes of the two-byte tokens (the Axe engine's GDB1)
Prefixes:	.db 05Ch, 05Dh, 05Eh, 060h, 061h, 062h, 063h, 07Eh, 0AAh, 0BBh, 0EFh

; Alphanumeric punctuation in value order, values 36-44: space $ % * + - . / : (GDB9)
Punct:		.db " $%*+-./:"

; The token for each ASCII character 32-126 (GDB0), as two 95-byte rows: the first bytes
; (BBh for the lowercase letters and other two-byte ones, which are all BB-prefixed), then
; the second bytes (0 for a one-byte token). Position in a row + 31 = the ASCII code.
TokenFirst:
	.db 029h, 02Dh, 02Ah, 0BBh, 0BBh, 0BBh, 0BBh, 0AEh, 010h, 011h, 082h, 070h, 02Bh, 071h, 03Ah, 083h
	.db 030h, 031h, 032h, 033h, 034h, 035h, 036h, 037h, 038h, 039h, 03Eh, 0BBh, 06Bh, 06Ah, 06Ch, 0AFh
	.db 0BBh, 041h, 042h, 043h, 044h, 045h, 046h, 047h, 048h, 049h, 04Ah, 04Bh, 04Ch, 04Dh, 04Eh, 04Fh
	.db 050h, 051h, 052h, 053h, 054h, 055h, 056h, 057h, 058h, 059h, 05Ah, 006h, 0BBh, 007h, 0F0h, 0BBh
	.db 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh
	.db 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 008h, 0BBh, 009h, 0BBh
TokenSecond:
	.db 000h, 000h, 000h, 0D2h, 0D3h, 0DAh, 0D4h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h
	.db 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 0D6h, 000h, 000h, 000h, 000h
	.db 0D1h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h
	.db 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 0D7h, 000h, 000h, 0D9h
	.db 0D5h, 0B0h, 0B1h, 0B2h, 0B3h, 0B4h, 0B5h, 0B6h, 0B7h, 0B8h, 0B9h, 0BAh, 0BCh, 0BDh, 0BEh, 0BFh
	.db 0C0h, 0C1h, 0C2h, 0C3h, 0C4h, 0C5h, 0C6h, 0C7h, 0C8h, 0C9h, 0CAh, 000h, 0D8h, 000h, 0CFh
