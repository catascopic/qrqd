; prgmθQR in Z80 assembly: the standalone release's QR engine, ported from QRSRC.axe.txt
; (docs/asm_port.md). Assembled by spasm-ng (tools/build.py runs it), run by prgmQR with
; Asm(prgmθQR) exactly like the Axe engine; the interface is docs/standalone/API.md.
;
; Milestone 4: reads the parameters, rejects bad ones, finds the input, answers the check
; call (V=0) for Str1 and ʟBIN (the length, the mode, the first bad character's position in
; B), and for a draw call (V=1-11) packs the data codewords into L₁. What follows (error
; correction, drawing) isn't written yet: a draw call returns Ans = 0 (NotYet) with only the
; data codewords in L₁. So do E=3 (a note) and E=4 (the note list).
;
; Rules for the whole program (the OS needs them): keep IY (the OS flags pointer), leave
; interrupts on, return with the stack where it started, and write only the scratch areas of
; design.md's memory map (saveSScreen = L₁, appBackUpScreen = L₃, plotSScreen = the graph
; buffer), OP1-OP6 and the program's own variables. Every bcall may change every register but
; IY (the tests make sure nothing counts on one surviving), and the OS's interrupt handler
; changes the shadow registers, so they are never used.

#include "ti83plus.inc"

; The engine's variables: the last 54 bytes of saveSScreen, where Axe keeps its own (which is
; why L₁ is 714 bytes, not 768), so L₁ keeps the same size as for the Axe engine. The Axe
; engine's letter for each is in brackets.
Vars		= saveSScreen+714
SaveSP		= Vars		; word: the stack pointer at the start, for Quit
Source		= Vars+2	; byte: [E] 1 Str1, 2 ʟBIN, 3 a note
Version		= Vars+3	; byte: [V] 0-11, 0 = only check
Mode		= Vars+4	; byte: [F] 0 auto, 1 ASCII (byte mode), 2 alphanumeric
InputPtr	= Vars+5	; word: [P] the input's first byte (Str1 token or ʟBIN element)
InputSize	= Vars+7	; word: Str1's size in bytes, or ʟBIN's element count
Length		= Vars+9	; word: [T] the input's length in characters (Str1: tokens)
ReadPtr		= Vars+11	; word: [P] CH's place in Str1
Pos		= Vars+13	; word: [O] the position of the character CH read last (1 = first)
BadPos		= Vars+15	; word: [K] the first character that can't be encoded, 0 if none
NonAlnumPos	= Vars+17	; word: [X] the first one alphanumeric mode can't encode, 0 if none
Count		= Vars+19	; word: [N] characters to encode
Skip		= Vars+21	; word: [θ] characters to skip first
DataCount	= Vars+23	; word: [M] data codewords of the version (EC level L)
ECPerBlock	= Vars+25	; byte: [R] EC codewords per block
Blocks		= Vars+26	; byte: [B] number of blocks
OutPtr		= Vars+27	; word: [D] where AB stores the next full byte
BitAcc		= Vars+29	; byte: [W] the byte AB is filling
BitCount	= Vars+30	; byte: [K] bits in BitAcc, 0-7

	.org userMem-2
	.db t2ByteTok, tasmCmp		; BB 6D: a compiled assembly program, run by Asm(

Start:
	ld (SaveSP),sp

; Full: 15 MHz on a TI-84+ or a Silver Edition, nothing on a plain TI-83+. Port 2 bit 7 is
; set on the models that have the fast mode; on those, port 20h bit 0 selects 15 MHz. A plain
; 83+ has no port 20h (it mirrors the link port there), so it is left alone. The OS goes
; back to 6 MHz itself when the program returns (design.md item 16).
	in a,(2)
	rla				; bit 7 → carry
	jr nc,SlowModel
	ld a,1
	out (20h),a
SlowModel:

; Read the parameters (GV gives 0 for a missing variable). Each is checked as it is read; a
; value above 255 can't be valid, so H must be 0 and the rest is a byte.
	ld a,'E'
	call GV
	ld a,h
	or a
	jp nz,BadInput
	ld a,l
	cp 4				; E=4 is a separate job: list the notes
	jp z,NotYet
	dec a				; E-1 > 2 rejects E=0 too: 0-1 wraps around to 255
	cp 3
	jp nc,BadInput
	inc a
	ld (Source),a
	ld a,'V'
	call GV
	ld a,h
	or a
	jp nz,BadInput
	ld a,l
	cp 12
	jp nc,BadInput
	ld (Version),a
	ld a,'M'
	call GV
	ld a,h
	or a
	jp nz,BadInput
	ld a,l
	cp 3
	jp nc,BadInput
	ld (Mode),a

; Find the input. A missing one (or an archived one: the Axe engine's GetCalc doesn't open
; those either) is bad input.
	ld a,(Source)
	cp 3
	jp z,NotYet			; a note: milestone 8
	cp 2
	ld hl,NameStr1
	jr nz,FindInput
; ʟBIN is always byte mode
	ld a,1
	ld (Mode),a
	ld hl,NameBIN
FindInput:
	call FindVar
	jp c,BadInput
; DE = the size word (Str1: bytes, ʟBIN: elements), then the data
	ex de,hl
	ld c,(hl)
	inc hl
	ld b,(hl)
	inc hl
	ld (InputPtr),hl
	ld (InputSize),bc
	ld (Length),bc			; ʟBIN: one element per character
	ld a,(Source)
	cp 1
	jr nz,Measured

; Str1: the size word gives bytes, but a character can be a two-byte token, so count the
; tokens. HL walks the string (from its first token), DE = the end, BC counts.
	ld e,l
	ld d,h
	add hl,bc
	ex de,hl
	ld bc,0
CountTokens:
	or a				; while HL < DE
	sbc hl,de
	add hl,de
	jr nc,Counted
	inc bc
	ld a,(hl)
	inc hl
	push bc
	call IsPrefix
	pop bc
	jr nz,CountTokens
	inc hl				; a two-byte token
	jr CountTokens
Counted:
	ld (Length),bc
Measured:

; The check's answer is 2T+1 at most, so T ≤ 32765 keeps it below the error codes (65532 and
; up). Tested before the scan, which would take long on a huge note.
	ld a,(Version)
	or a
	jr nz,LengthOK
	ld hl,32765
	ld bc,(Length)
	or a
	sbc hl,bc
	jr nc,LengthOK
	ld hl,65532
	jp Quit
LengthOK:

; Scan the text: always for a check (V=0), and for a draw in auto mode (M=0: no check told us
; the mode); otherwise the draw trusts the earlier check. ʟBIN has nothing to scan.
	ld a,(Source)
	cp 2
	jp z,Scanned
	ld a,(Version)
	or a
	jr z,Scan
	ld a,(Mode)
	or a
	jp nz,Scanned
Scan:
	ld hl,0
	ld (Pos),hl
	ld (BadPos),hl
	ld (NonAlnumPos),hl
	ld hl,(InputPtr)
	ld (ReadPtr),hl
ScanLoop:
	ld hl,(Pos)			; while Pos < Length
	ld de,(Length)
	or a
	sbc hl,de
	jr nc,ScanDone
	call CH				; A = the next character's ASCII code, 0 if none
	ld c,a
; The first character outside printable ASCII (32-126) and newline (10)
	ld hl,(BadPos)
	ld a,h
	or l
	jr nz,ScanAlnum
	ld a,c
	cp 10
	jr z,ScanAlnum
	sub 32				; 32-126 → 0-94; below 32 wraps around to 224 and up
	cp 95
	jr c,ScanAlnum
	ld hl,(Pos)
	ld (BadPos),hl
; The first one alphanumeric mode can't encode (no more testing after it)
ScanAlnum:
	ld hl,(NonAlnumPos)
	ld a,h
	or l
	jr nz,ScanLoop
	ld a,c
	call AV
	jr nc,ScanLoop
	ld hl,(Pos)
	ld (NonAlnumPos),hl
	jr ScanLoop
ScanDone:
; Forced alphanumeric: the first non-alphanumeric character is the problem
	ld a,(Mode)
	cp 2
	jr nz,NotForced
	ld hl,(NonAlnumPos)
	ld (BadPos),hl
NotForced:
; Auto: alphanumeric (2) if every character allowed it, else byte mode (1)
	or a
	jr nz,ModeKnown
	ld hl,(NonAlnumPos)
	ld a,h
	or l
	ld a,1
	jr nz,AutoByte
	inc a
AutoByte:
	ld (Mode),a
ModeKnown:
; A problem character: its position goes into B (only if B exists). A note in byte mode just
; warns (its bytes go out as calculator codes); anything else fails.
	ld hl,(BadPos)
	ld a,h
	or l
	jr z,Scanned
	call StoreB
	ld a,(Source)
	cp 3
	jr nz,BadChar
	ld a,(Mode)
	cp 1
	jr z,Scanned
BadChar:
	ld hl,65533
	jp Quit
Scanned:

; Check only: 2T+1 if alphanumeric (Mode 2), 2T if byte mode (Mode 1)
	ld a,(Version)
	or a
	jr nz,Encode
	ld hl,(Length)
	add hl,hl
	ld a,(Mode)
	dec a
	ld e,a
	ld d,0
	add hl,de
	jp Quit

; ---------- a draw call: from here Mode is 1 (byte) or 2 (alphanumeric) ----------
Encode:
	ld a,'N'
	call GV
	ld (Count),hl
	ld a,'O'
	call GV
	ld (Skip),hl

; The version's data codewords, EC codewords per block and blocks (EC level L)
	ld a,(Version)
	dec a
	ld c,a
	ld b,0				; BC = V-1
	ld hl,DataWords
	add hl,bc
	add hl,bc
	ld e,(hl)
	inc hl
	ld d,(hl)
	ld (DataCount),de
	ld hl,ECTable
	add hl,bc
	ld a,(hl)
	ld (ECPerBlock),a
	ld hl,BlockTable
	add hl,bc
	ld a,(hl)
	ld (Blocks),a

; Clamp the skip and the count to the text. Count ≤ 468 only keeps a bad N from writing past
; L₁; keeping N within the version's capacity is the caller's job.
	ld hl,(Length)
	ld de,(Skip)
	or a
	sbc hl,de			; HL = T - θ
	jr nc,SkipOK
	add hl,de			; θ > T: skip to the end (HL+DE = T)
	ld (Skip),hl
	ld hl,0
SkipOK:
	ld de,(Count)
	or a				; N > T-θ: N = T-θ (sbc then add leaves HL, and the carry
	sbc hl,de			; of the comparison)
	add hl,de
	jr nc,CountFits
	ld (Count),hl
CountFits:
	ld hl,(Count)
	ld de,469
	or a
	sbc hl,de
	jr c,CountOK
	ld hl,468
	ld (Count),hl
CountOK:

; Bit-pack the data codewords into L₁ with AB
	ld hl,saveSScreen
	ld (OutPtr),hl
	xor a
	ld (BitAcc),a
	ld (BitCount),a
; Mode indicator, 4 bits: 0100 byte mode, 0010 alphanumeric
	ld a,(Mode)
	cp 1
	ld hl,4
	jr z,ModeBits
	ld l,2
ModeBits:
	ld b,4
	call AB
; The character count; its width from CountWidths: byte v1-9, v10+, alphanumeric v1-9, v10+
	ld a,(Mode)
	dec a
	add a,a
	ld c,a
	ld a,(Version)
	cp 10
	jr c,CountWidth
	inc c
CountWidth:
	ld b,0
	ld hl,CountWidths
	add hl,bc
	ld b,(hl)
	ld hl,(Count)
	call AB

	ld a,(Source)
	cp 2
	jr nz,PackText

; ʟBIN: skip θ elements (9 bytes each), then 8 bits per element (FloatToInt makes the OS float
; an integer; AB takes its low 8 bits)
	ld hl,(Skip)
	ld d,h
	ld e,l
	add hl,hl
	add hl,hl
	add hl,hl
	add hl,de
	ld de,(InputPtr)
	add hl,de
	ld (ReadPtr),hl
	ld bc,(Count)
PackList:
	ld a,b
	or c
	jp z,Packed
	push bc
	ld de,(ReadPtr)
	ld hl,9
	add hl,de
	ld (ReadPtr),hl
	call FloatToInt
	ld b,8
	call AB
	pop bc
	dec bc
	jr PackList

; Str1: skip θ tokens, stepping over each by its length (no table lookup needed)
PackText:
	ld hl,(Skip)
	ld (Pos),hl
	ld b,h
	ld c,l
	ld hl,(InputPtr)
SkipTokens:
	ld a,b
	or c
	jr z,Skipped
	ld a,(hl)
	inc hl
	push bc
	call IsPrefix
	pop bc
	jr nz,SkipOne
	inc hl				; a two-byte token
SkipOne:
	dec bc
	jr SkipTokens
Skipped:
	ld (ReadPtr),hl
	ld a,(Mode)
	cp 2
	jr z,PackAlnum

; Byte mode: 8 bits per character
	ld bc,(Count)
PackBytes:
	ld a,b
	or c
	jr z,Packed
	push bc
	call CH
	ld l,a
	ld h,0
	ld b,8
	call AB
	pop bc
	dec bc
	jr PackBytes

; Alphanumeric: each pair as 45·first+second in 11 bits...
PackAlnum:
	ld hl,(Count)
	srl h
	rr l
	ld b,h
	ld c,l				; BC = pairs
PackPairs:
	ld a,b
	or c
	jr z,PackOdd
	push bc
	call CH
	call AV
	ld l,a				; HL = 45·value, as 9·(5·value)
	ld h,0
	ld d,h
	ld e,l
	add hl,hl
	add hl,hl
	add hl,de
	ld d,h
	ld e,l
	add hl,hl
	add hl,hl
	add hl,hl
	add hl,de
	push hl
	call CH
	call AV
	pop hl
	ld e,a
	ld d,0
	add hl,de
	ld b,11
	call AB
	pop bc
	dec bc
	jr PackPairs
; ...and an odd last character in 6 bits
PackOdd:
	ld a,(Count)
	rra
	jr nc,Packed
	call CH
	call AV
	ld l,a
	ld h,0
	ld b,6
	call AB
Packed:

; Terminator: up to 4 zero bits, fewer if the data is full. Bits left = 8M - bits written
; ((OutPtr-L₁)·8 + BitCount); like the Axe engine's, the subtraction wraps around if a bad N
; overfilled the version, which then counts as "more than 4 left".
	ld hl,(OutPtr)
	ld de,saveSScreen
	or a
	sbc hl,de
	add hl,hl
	add hl,hl
	add hl,hl
	ld a,(BitCount)
	ld e,a
	ld d,0
	add hl,de
	ex de,hl			; DE = bits written
	ld hl,(DataCount)
	add hl,hl
	add hl,hl
	add hl,hl
	or a
	sbc hl,de			; HL = bits left
	ld a,h
	or a
	jr nz,Term4
	ld a,l
	cp 5
	jr c,TermBits
Term4:
	ld a,4
TermBits:
	or a
	jr z,Terminated
	ld b,a
	ld hl,0
	call AB
Terminated:
; Zero bits up to the next byte boundary
	ld a,(BitCount)
	or a
	jr z,Aligned
	ld b,a
	ld a,8
	sub b
	ld b,a
	ld hl,0
	call AB
Aligned:
; Fill the rest with pad bytes 236 (ECh) and 17 (11h) in turn: 236 xor 253 = 17, and back
	ld hl,(DataCount)
	ld de,saveSScreen
	add hl,de
	ex de,hl			; DE = the end of the data codewords
	ld hl,(OutPtr)
	ld c,236
Pad:
	or a
	sbc hl,de
	add hl,de
	jr nc,Padded
	ld (hl),c
	inc hl
	ld a,c
	xor 253
	ld c,a
	jr Pad
Padded:
	jr NotYet

; ---------- leaving ----------

; BadInput: Ans = 65535 (bad E, V or M, or the input doesn't exist), and return.
BadInput:
	ld hl,65535
	jr Quit

; NotYet: what isn't ported yet answers 0, like the milestone 1 stub.
NotYet:
	ld hl,0

; Quit: Ans = HL, and return to prgmQR from anywhere: the stack goes back to where it was at
; the start, so this works from inside subroutines too.
Quit:
	ld sp,(SaveSP)
	bcall(_SetXXXXOP2)		; OP2 = HL as a float
	bcall(_OP2ToOP1)
	bcall(_StoAns)
	ret

; ---------- subroutines ----------

; CH: the next character of Str1 → A, its ASCII code, 0 if it has none. Moves ReadPtr past
; the token and adds 1 to Pos. A token is found in TokenFirst (95 first bytes, one per
; ASCII 32-126), or, for a two-byte token, its second byte in TokenSecond. Only BBh tokens
; have ASCII among the two-byte ones; BB 00 is npv(, never a character (0 in TokenSecond
; means a one-byte token). Changes AF, BC, DE, HL.
CH:
	ld hl,(Pos)
	inc hl
	ld (Pos),hl
	ld hl,(ReadPtr)
	ld a,(hl)
	inc hl
	ld e,a				; E = the first byte
	call IsPrefix
	jr nz,CH_OneByte
	ld d,(hl)			; D = the second byte
	inc hl
	ld (ReadPtr),hl
	ld a,e
	cp 0BBh
	jr nz,CH_None
	ld a,d
	or a
	jr z,CH_None
	ld hl,TokenSecond
	jr CH_Search
CH_OneByte:
	ld (ReadPtr),hl
	ld a,e
	ld hl,TokenFirst
CH_Search:
	ld bc,95
	cpir
	jr nz,CH_None
; found at row position 95-BC (1-95, cpir counted the match too): ASCII = 31 + that
	ld a,126
	sub c
	ret
CH_None:
	xor a
	ret

; AB: append the low B bits (1-16) of HL to the data codewords, highest first. HL is first
; shifted left so its first bit is bit 15; then each add hl,hl pushes the next bit into
; carry, and rla moves it into BitAcc (kept in A), whose old bits leave from the top. Every 8
; bits A is stored at OutPtr. Changes AF, BC, DE, HL.
AB:
	ld a,16
	sub b
	jr z,AB_Ready
AB_Align:
	add hl,hl
	dec a
	jr nz,AB_Align
AB_Ready:
	ld de,(OutPtr)
	ld a,(BitCount)
	ld c,a
	ld a,(BitAcc)
AB_Bit:
	add hl,hl
	rla
	inc c
	bit 3,c				; 8 bits?
	jr z,AB_Next
	ld (de),a
	inc de
	ld c,0
AB_Next:
	djnz AB_Bit
	ld (OutPtr),de
	ld (BitAcc),a
	ld a,c
	ld (BitCount),a
	ret

; IsPrefix: Z if A is the first byte of a two-byte token. Changes F, BC; keeps A, DE, HL.
IsPrefix:
	push hl
	ld hl,Prefixes
	ld bc,11
	cpir
	pop hl
	ret

; AV: ASCII A → its alphanumeric value in A (0-9 digits, 10-35 A-Z, 36-44 space $ % * + - .
; / :), carry clear; carry set if alphanumeric mode has none. The subtractions wrap around
; below 0 (a code below '0' becomes a large number), and adding 'A' back undoes them, so A is
; the ASCII code again when it reaches the punctuation table. Changes AF, BC, HL.
AV:
	sub '0'
	cp 10
	jr c,AV_OK			; 0-9
	sub 'A'-'0'
	cp 26
	jr nc,AV_Punct
	add a,10			; A-Z → 10-35
AV_OK:
	or a
	ret
AV_Punct:
	add a,'A'
	ld hl,Punct
	ld bc,9
	cpir
	scf
	ret nz
; found at position 9-BC (1-9): value 35 + that
	ld a,44
	sub c
	ret

; GV: the OS real variable named A ('E', 'V', ...) → HL as an integer (FloatToInt), 0 if it
; doesn't exist or is archived. Changes AF, BC, DE, HL, OP1.
GV:
	call RealToOP1
	call FindOP1
	ld hl,0
	ret c
	; fall through: DE = the float

; FloatToInt: the 9-byte float at DE → HL, its integer part (the fraction is dropped). A
; negative number, or one of 65536 or more, gives 65535: every parameter rejects or clamps
; that. (Axe's float{ isn't documented for those, so this is a choice, not a copy.)
; The float: a sign byte (bit 7), the exponent byte (80h + the power of ten), then 14 BCD
; digits, two to a byte, the first being the units digit when the exponent is 80h. So the
; integer part is the first exponent-7Fh digits. Changes AF, BC, DE, HL.
FloatToInt:
	ld a,(de)
	rla				; sign → carry
	jr c,FTI_Max
	inc de
	ld a,(de)
	sub 80h				; A = the power of ten
	ld hl,0
	ret c				; below 1: 0
	cp 5
	jr nc,FTI_Max			; 100000 or more
	inc a
	ld b,a				; B = digits before the point, 1-5
	inc de				; the first pair of digits
	ld c,0				; C = 0 for the high digit of the byte, 1 for the low one
FTI_Digit:
	ld a,(de)
	bit 0,c
	jr nz,FTI_Low
	rrca
	rrca
	rrca
	rrca
FTI_Low:
	and 0Fh
	push de				; HL = 10·HL + A, any carry out of 16 bits is too big
	ld d,h
	ld e,l
	add hl,hl
	jr c,FTI_Over
	add hl,hl
	jr c,FTI_Over
	add hl,de			; ·5
	jr c,FTI_Over
	add hl,hl			; ·10
	jr c,FTI_Over
	ld e,a
	ld d,0
	add hl,de
	jr c,FTI_Over
	pop de
	ld a,c				; next digit: the low half of this byte, or the next byte
	xor 1
	ld c,a
	jr nz,FTI_Next
	inc de
FTI_Next:
	djnz FTI_Digit
	ret
FTI_Over:
	pop de
FTI_Max:
	ld hl,65535
	ret

; StoreB: B = HL (as a float), if a real variable B exists in RAM; nothing otherwise (the
; engine never creates variables). A complex B is left alone: a real's float in its first
; half would leave it half real. Changes AF, BC, DE, HL, OP1, OP2.
StoreB:
	push hl
	ld a,'B'
	call RealToOP1
	call FindOP1
	jr c,StoreB_None
	ld a,(hl)			; HL = its VAT entry: the type is in the low 5 bits
	and 1Fh
	jr nz,StoreB_None
	pop hl
	push de				; DE = its data
	bcall(_SetXXXXOP2)		; OP2 = HL as a float
	pop de
	ld hl,OP2
	ld bc,9
	ldir
	ret
StoreB_None:
	pop hl
	ret

; RealToOP1: OP1 = the name of the real variable A: type 0, the letter, 0, 0. Changes HL.
RealToOP1:
	ld hl,OP1
	ld (hl),RealObj
	inc hl
	ld (hl),a
	inc hl
	ld (hl),0
	inc hl
	ld (hl),0
	ret

; FindVar: find the OS variable whose name (9 bytes, OP1 style: type, name, zeros) is at HL.
; Carry set if it doesn't exist or is archived; else DE = its data (in RAM) and HL = its VAT
; entry. Changes AF, BC, DE, HL, OP1.
FindVar:
	ld de,OP1
	ld bc,9
	ldir
FindOP1:			; the same, with the name already in OP1
	bcall(_ChkFindSym)
	ret c
	ld a,b				; B = flash page, 0 in RAM
	or a
	ret z
	scf
	ret

; ---------- data ----------

NameStr1:	.db StrngObj, tVarStrng, tStr1, 0, 0, 0, 0, 0, 0
NameBIN:	.db ListObj, tVarLst, "BIN", 0, 0, 0, 0

; Per version 1-11 at EC level L (GDB3, GDB4, GDB5): data codewords (words), EC codewords per
; block, blocks
DataWords:	.dw 19, 34, 55, 80, 108, 136, 156, 194, 232, 274, 324
ECTable:	.db 7, 10, 15, 20, 26, 18, 20, 24, 30, 18, 20
BlockTable:	.db 1, 1, 1, 1, 1, 2, 2, 2, 2, 4, 4
; Character count widths: byte mode v1-9, v10+, alphanumeric v1-9, v10+ (GDB5+11)
CountWidths:	.db 8, 16, 9, 11

; The first bytes of the two-byte tokens (the Axe engine's GDB1)
Prefixes:	.db 05Ch, 05Dh, 05Eh, 060h, 061h, 062h, 063h, 07Eh, 0AAh, 0BBh, 0EFh

; Alphanumeric punctuation in value order, values 36-44: space $ % * + - . / : (GDB9)
Punct:		.db " $%*+-./:"

; The token for each ASCII character 32-126 (GDB0), as two 95-byte rows: the first bytes
; (BBh for the lowercase letters and other two-byte ones, which are all BB-prefixed), then
; the second bytes (0 for a one-byte token). Position in a row + 31 = the ASCII code.
TokenFirst:
	.db 029h, 02Dh, 02Ah, 0BBh, 0BBh, 0BBh, 0BBh, 0AEh, 010h, 011h, 082h, 070h, 02Bh, 071h, 03Ah, 083h
