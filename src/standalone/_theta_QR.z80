; prgmθQR in Z80 assembly: the standalone release's QR engine, ported from QRSRC.axe.txt
; (docs/asm_port.md). Assembled by spasm-ng (tools/build.py runs it), run by prgmQR with
; Asm(prgmθQR) exactly like the Axe engine; the interface is docs/standalone/API.md.
;
; Everything the Axe engine does: for Str1 (E=1), ʟBIN (E=2) and a NoteFolio note (E=3, in
; RAM or archived), the check call (V=0: the length, the mode, the first problem character's
; position in B) and the draw calls (V=1-11: data codewords, error correction, the drawing,
; Ans = 0); and E=4, the list of notes in Str3 for prgmQR's menu.
;
; Rules for the whole program (the OS needs them): keep IY (the OS flags pointer), leave
; interrupts on, return with the stack where it started, and write only the scratch areas of
; design.md's memory map (saveSScreen = L₁, appBackUpScreen = L₃, plotSScreen = the graph
; buffer), OP1-OP6 and the program's own variables. Every bcall may change every register but
; IY (the tests make sure nothing counts on one surviving), and the OS's interrupt handler
; changes the shadow registers, so they are never used.

#include "ti83plus.inc"

; The engine's variables: the last 54 bytes of saveSScreen, where Axe keeps its own (which is
; why L₁ is 714 bytes, not 768), so L₁ keeps the same size as for the Axe engine. The Axe
; engine's letter for each is in brackets.
Vars		= saveSScreen+714
SaveSP		= Vars		; word: the stack pointer at the start, for Quit
Source		= Vars+2	; byte: [E] 1 Str1, 2 ʟBIN, 3 a note
Version		= Vars+3	; byte: [V] 0-11, 0 = only check
Mode		= Vars+4	; byte: [F] 0 auto, 1 ASCII (byte mode), 2 alphanumeric
InputPtr	= Vars+5	; word: [P] the input's first byte (Str1 token or ʟBIN element)
InputSize	= Vars+7	; word: Str1's size in bytes, or ʟBIN's element count
Length		= Vars+9	; word: [T] the input's length in characters (Str1: tokens)
ReadPtr		= Vars+11	; word: [P] CH's place in Str1
Pos		= Vars+13	; word: [O] the position of the character CH read last (1 = first)
BadPos		= Vars+15	; word: [K] the first character that can't be encoded, 0 if none
NonAlnumPos	= Vars+17	; word: [X] the first one alphanumeric mode can't encode, 0 if none
Count		= Vars+19	; word: [N] characters to encode
Skip		= Vars+21	; word: [θ] characters to skip first
DataCount	= Vars+23	; word: [M] data codewords of the version (EC level L)
ECPerBlock	= Vars+25	; byte: [R] EC codewords per block
Blocks		= Vars+26	; byte: [B] number of blocks
OutPtr		= Vars+27	; word: [D] where AB stores the next full byte
BitAcc		= Vars+29	; byte: [W] the byte AB is filling
BitCount	= Vars+30	; byte: [K] bits in BitAcc, 0-7
ShortLen	= Vars+31	; byte: [Y] data codewords in a short block (M / B)
LongBlocks	= Vars+32	; byte: [U] blocks one codeword longer, the last ones (M mod B)
BlockPtr	= Vars+33	; word: [A] the next block's data codewords, for RS
ECPtr		= Vars+35	; word: [Z] where RS writes the next block's EC codewords
NotePage	= Vars+37	; byte: the open note's flash page, 0 if it is in RAM
NoteAddr	= Vars+38	; word: [Q] its data (after the size word): the address in RAM, or
				; in flash the offset from 4000h on NotePage (0-3FFFh)
NoteSize	= Vars+40	; word: [U] its size (the appvar's size word)
ListPtr		= Vars+42	; word: [P] the VAT entry LS is looking at
ListCount	= Vars+44	; byte: [K] notes listed so far (at most 80)
ListSize	= Vars+45	; word: Str3's size, 8 per note + 48

; The drawing's variables: past the 54 bytes above, so in L₁'s free space at +600 (design.md's
; memory map leaves L₁+503..699 unused)
DrawVars	= saveSScreen+600
Size		= DrawVars	; byte: [S] modules per side, 4V+17
RowOff		= DrawVars+1	; byte: [G] screen row of the symbol's top row (centered)
ColOff		= DrawVars+2	; byte: [H] screen column of its left column
AlignMid	= DrawVars+3	; byte: [W] the middle alignment coordinate, 0 below v7
AlignCount	= DrawVars+4	; byte: [A] alignment coordinates (2 or 3)
AlignX		= DrawVars+5	; byte: the alignment loops' counters
AlignY		= DrawVars+6
ShortBlocks	= DrawVars+7	; byte: [U] blocks of ShortLen codewords (the first ones)
BlockShift	= DrawVars+8	; byte: log₂ of the number of blocks (1, 2 or 4 → 0-2)
ShortTotal	= DrawVars+9	; word: ShortLen · blocks
ECTotal		= DrawVars+11	; word: EC codewords in all (R · blocks)
CWIndex		= DrawVars+13	; word: [Q] the codeword being drawn, in interleaved order
CWByte		= DrawVars+15	; byte: [D] that codeword
CWBit		= DrawVars+16	; byte: [Z] the mask of its next bit, from 80h down
ZigPair		= DrawVars+17	; byte: [K] the zigzag's column pair, from the right
ZigCol		= DrawVars+18	; byte: [X] that pair's right column
ZigStep		= DrawVars+19	; byte: [I] the step along the pair (0 to S-1)
RectOp	= DrawVars+20	; byte: Rect's operation, 0 fill, 1 invert
VersionBits	= DrawVars+21	; word: the version information still to draw
VersionIdx	= DrawVars+23	; byte: its bit number, 0-17

; Work areas (design.md's memory map)
Map		= appBackUpScreen	; while drawing: the function modules, one pixel each, at
					; module coordinates (no offset), like a 96×64 screen
Align		= saveSScreen+500	; alignment pattern coordinates (2 or 3)
AppvarName	= saveSScreen+700	; OP1-style name of the note: 15h, the name, 0
ECOut		= saveSScreen+330	; EC codewords, block after block, R apart
Gen		= saveSScreen+420	; generator polynomial: 1, then R coefficients as logs
Rem		= saveSScreen+460	; RS remainder, R+1 bytes
ExpTable	= appBackUpScreen	; 2^i at +i, written twice (i = 0-509) so a sum of two
					; logs needs no mod 255
LogTable	= appBackUpScreen+512	; log of x at +x (x = 1-255)

	.org userMem-2
	.db t2ByteTok, tasmCmp		; BB 6D: a compiled assembly program, run by Asm(

Start:
	ld (SaveSP),sp

; Full: 15 MHz on a TI-84+ or a Silver Edition, nothing on a plain TI-83+. Port 2 bit 7 is
; set on the models that have the fast mode; on those, port 20h bit 0 selects 15 MHz. A plain
; 83+ has no port 20h (it mirrors the link port there), so it is left alone. The OS goes
; back to 6 MHz itself when the program returns (design.md item 16).
	in a,(2)
	rla				; bit 7 → carry
	jr nc,SlowModel
	ld a,1
	out (20h),a
SlowModel:

; Read the parameters (GV gives 0 for a missing variable). Each is checked as it is read; a
; value above 255 can't be valid, so H must be 0 and the rest is a byte.
	ld a,'E'
	call GV
	ld a,h
	or a
	jp nz,BadInput
	ld a,l
	cp 4				; E=4 is a separate job: list the notes
	jp z,ListNotes
	dec a				; E-1 > 2 rejects E=0 too: 0-1 wraps around to 255
	cp 3
	jp nc,BadInput
	inc a
	ld (Source),a
	ld a,'V'
	call GV
	ld a,h
	or a
	jp nz,BadInput
	ld a,l
	cp 12
	jp nc,BadInput
	ld (Version),a
	ld a,'M'
	call GV
	ld a,h
	or a
	jp nz,BadInput
	ld a,l
	cp 3
	jp nc,BadInput
	ld (Mode),a

; Find the input. A missing one (or an archived one: the Axe engine's GetCalc doesn't open
; those either) is bad input.
	ld a,(Source)
	cp 3
	jr z,FindNote
	cp 2
	ld hl,NameStr1
	jr nz,FindInput
; ʟBIN is always byte mode
	ld a,1
	ld (Mode),a
	ld hl,NameBIN
FindInput:
	call FindVar
	jp c,BadInput
; DE = the size word (Str1: bytes, ʟBIN: elements), then the data
	ex de,hl
	ld c,(hl)
	inc hl
	ld b,(hl)
	inc hl
	ld (InputPtr),hl
	ld (InputSize),bc
	ld (Length),bc			; ʟBIN: one element per character
	ld a,(Source)
	cp 1
	jr nz,Measured

; Str1: the size word gives bytes, but a character can be a two-byte token, so count the
; tokens. HL walks the string (from its first token), DE = the end, BC counts.
	ld e,l
	ld d,h
	add hl,bc
	ex de,hl
	ld bc,0
CountTokens:
	or a				; while HL < DE
	sbc hl,de
	add hl,de
	jr nc,Counted
	inc bc
	ld a,(hl)
	inc hl
	push bc
	call IsPrefix
	pop bc
	jr nz,CountTokens
	inc hl				; a two-byte token
	jr CountTokens
Counted:
	ld (Length),bc
	jr Measured

; A note: NF opens the one named in Str2 and measures its text
FindNote:
	call NF
	jp c,BadInput
	ld (Length),hl
Measured:

; The check's answer is 2T+1 at most, so T ≤ 32765 keeps it below the error codes (65532 and
; up). Tested before the scan, which would take long on a huge note.
	ld a,(Version)
	or a
	jr nz,LengthOK
	ld hl,32765
	ld bc,(Length)
	or a
	sbc hl,bc
	jr nc,LengthOK
	ld hl,65532
	jp Quit
LengthOK:

; Scan the text: always for a check (V=0), and for a draw in auto mode (M=0: no check told us
; the mode); otherwise the draw trusts the earlier check. ʟBIN has nothing to scan.
	ld a,(Source)
	cp 2
	jp z,Scanned
	ld a,(Version)
	or a
	jr z,Scan
	ld a,(Mode)
	or a
	jp nz,Scanned
Scan:
	ld hl,0
	ld (Pos),hl
	ld (BadPos),hl
	ld (NonAlnumPos),hl
	ld hl,(InputPtr)
	ld (ReadPtr),hl
ScanLoop:
	ld hl,(Pos)			; while Pos < Length
	ld de,(Length)
	or a
	sbc hl,de
	jr nc,ScanDone
	call CH				; A = the next character's ASCII code, 0 if none
	ld c,a
; The first character outside printable ASCII (32-126) and newline (10)
	ld hl,(BadPos)
	ld a,h
	or l
	jr nz,ScanAlnum
	ld a,c
	cp 10
	jr z,ScanAlnum
	sub 32				; 32-126 → 0-94; below 32 wraps around to 224 and up
	cp 95
	jr c,ScanAlnum
	ld hl,(Pos)
	ld (BadPos),hl
; The first one alphanumeric mode can't encode (no more testing after it)
ScanAlnum:
	ld hl,(NonAlnumPos)
	ld a,h
	or l
	jr nz,ScanLoop
	ld a,c
	call AV
	jr nc,ScanLoop
	ld hl,(Pos)
	ld (NonAlnumPos),hl
	jr ScanLoop
ScanDone:
; Forced alphanumeric: the first non-alphanumeric character is the problem
	ld a,(Mode)
	cp 2
	jr nz,NotForced
	ld hl,(NonAlnumPos)
	ld (BadPos),hl
NotForced:
; Auto: alphanumeric (2) if every character allowed it, else byte mode (1)
	or a
	jr nz,ModeKnown
	ld hl,(NonAlnumPos)
	ld a,h
	or l
	ld a,1
	jr nz,AutoByte
	inc a
AutoByte:
	ld (Mode),a
ModeKnown:
; A problem character: its position goes into B (only if B exists). A note in byte mode just
; warns (its bytes go out as calculator codes); anything else fails.
	ld hl,(BadPos)
	ld a,h
	or l
	jr z,Scanned
	call StoreB
	ld a,(Source)
	cp 3
	jr nz,BadChar
	ld a,(Mode)
	cp 1
	jr z,Scanned
BadChar:
	ld hl,65533
	jp Quit
Scanned:

; Check only: 2T+1 if alphanumeric (Mode 2), 2T if byte mode (Mode 1)
	ld a,(Version)
	or a
	jr nz,Encode
	ld hl,(Length)
	add hl,hl
	ld a,(Mode)
	dec a
	ld e,a
	ld d,0
	add hl,de
	jp Quit

; ---------- a draw call: from here Mode is 1 (byte) or 2 (alphanumeric) ----------
Encode:
	ld a,'N'
	call GV
	ld (Count),hl
	ld a,'O'
	call GV
	ld (Skip),hl

; The version's data codewords, EC codewords per block and blocks (EC level L)
	ld a,(Version)
	dec a
	ld c,a
	ld b,0				; BC = V-1
	ld hl,DataWords
	add hl,bc
	add hl,bc
	ld e,(hl)
	inc hl
	ld d,(hl)
	ld (DataCount),de
	ld hl,ECTable
	add hl,bc
	ld a,(hl)
	ld (ECPerBlock),a
	ld hl,BlockTable
	add hl,bc
	ld a,(hl)
	ld (Blocks),a

; Clamp the skip and the count to the text. Count ≤ 468 only keeps a bad N from writing past
; L₁; keeping N within the version's capacity is the caller's job.
	ld hl,(Length)
	ld de,(Skip)
	or a
	sbc hl,de			; HL = T - θ
	jr nc,SkipOK
	add hl,de			; θ > T: skip to the end (HL+DE = T)
	ld (Skip),hl
	ld hl,0
SkipOK:
	ld de,(Count)
	or a				; N > T-θ: N = T-θ (sbc then add leaves HL, and the carry
	sbc hl,de			; of the comparison)
	add hl,de
	jr nc,CountFits
	ld (Count),hl
CountFits:
	ld hl,(Count)
	ld de,469
	or a
	sbc hl,de
	jr c,CountOK
	ld hl,468
	ld (Count),hl
CountOK:

; Bit-pack the data codewords into L₁ with AB
	ld hl,saveSScreen
	ld (OutPtr),hl
	xor a
	ld (BitAcc),a
	ld (BitCount),a
; Mode indicator, 4 bits: 0100 byte mode, 0010 alphanumeric
	ld a,(Mode)
	cp 1
	ld hl,4
	jr z,ModeBits
	ld l,2
ModeBits:
	ld b,4
	call AB
; The character count; its width from CountWidths: byte v1-9, v10+, alphanumeric v1-9, v10+
	ld a,(Mode)
	dec a
	add a,a
	ld c,a
	ld a,(Version)
	cp 10
	jr c,CountWidth
	inc c
CountWidth:
	ld b,0
	ld hl,CountWidths
	add hl,bc
	ld b,(hl)
	ld hl,(Count)
	call AB

	ld a,(Source)
	cp 2
	jr nz,PackText

; ʟBIN: skip θ elements (9 bytes each), then 8 bits per element (FloatToInt makes the OS float
; an integer; AB takes its low 8 bits)
	ld hl,(Skip)
	ld d,h
	ld e,l
	add hl,hl
	add hl,hl
	add hl,hl
	add hl,de
	ld de,(InputPtr)
	add hl,de
	ld (ReadPtr),hl
	ld bc,(Count)
PackList:
	ld a,b
	or c
	jp z,Packed
	push bc
	ld de,(ReadPtr)
	ld hl,9
	add hl,de
	ld (ReadPtr),hl
	call FloatToInt
	ld b,8
	call AB
	pop bc
	dec bc
	jr PackList

; Skip θ characters. A note: CH reads byte Pos+24 next, so setting Pos is enough. Str1: step
; over θ tokens by their length (no table lookup needed).
PackText:
	ld hl,(Skip)
	ld (Pos),hl
	ld a,(Source)
	cp 3
	jr z,TextReady
	ld b,h
	ld c,l
	ld hl,(InputPtr)
SkipTokens:
	ld a,b
	or c
	jr z,Skipped
	ld a,(hl)
	inc hl
	push bc
	call IsPrefix
	pop bc
	jr nz,SkipOne
	inc hl				; a two-byte token
SkipOne:
	dec bc
	jr SkipTokens
Skipped:
	ld (ReadPtr),hl
TextReady:
	ld a,(Mode)
	cp 2
	jr z,PackAlnum

; Byte mode: 8 bits per character
	ld bc,(Count)
PackBytes:
	ld a,b
	or c
	jr z,Packed
	push bc
	call CH
	ld l,a
	ld h,0
	ld b,8
	call AB
	pop bc
	dec bc
	jr PackBytes

; Alphanumeric: each pair as 45·first+second in 11 bits...
PackAlnum:
	ld hl,(Count)
	srl h
	rr l
	ld b,h
	ld c,l				; BC = pairs
PackPairs:
	ld a,b
	or c
	jr z,PackOdd
	push bc
	call CH
	call AV
	ld l,a				; HL = 45·value, as 9·(5·value)
	ld h,0
	ld d,h
	ld e,l
	add hl,hl
	add hl,hl
	add hl,de
	ld d,h
	ld e,l
	add hl,hl
	add hl,hl
	add hl,hl
	add hl,de
	push hl
	call CH
	call AV
	pop hl
	ld e,a
	ld d,0
	add hl,de
	ld b,11
	call AB
	pop bc
	dec bc
	jr PackPairs
; ...and an odd last character in 6 bits
PackOdd:
	ld a,(Count)
	rra
	jr nc,Packed
	call CH
	call AV
	ld l,a
	ld h,0
	ld b,6
	call AB
Packed:

; Terminator: up to 4 zero bits, fewer if the data is full. Bits left = 8M - bits written
; ((OutPtr-L₁)·8 + BitCount); like the Axe engine's, the subtraction wraps around if a bad N
; overfilled the version, which then counts as "more than 4 left".
	ld hl,(OutPtr)
	ld de,saveSScreen
	or a
	sbc hl,de
	add hl,hl
	add hl,hl
	add hl,hl
	ld a,(BitCount)
	ld e,a
	ld d,0
	add hl,de
	ex de,hl			; DE = bits written
	ld hl,(DataCount)
	add hl,hl
	add hl,hl
	add hl,hl
	or a
	sbc hl,de			; HL = bits left
	ld a,h
	or a
	jr nz,Term4
	ld a,l
	cp 5
	jr c,TermBits
Term4:
	ld a,4
TermBits:
	or a
	jr z,Terminated
	ld b,a
	ld hl,0
	call AB
Terminated:
; Zero bits up to the next byte boundary
	ld a,(BitCount)
	or a
	jr z,Aligned
	ld b,a
	ld a,8
	sub b
	ld b,a
	ld hl,0
	call AB
Aligned:
; Fill the rest with pad bytes 236 (ECh) and 17 (11h) in turn: 236 xor 253 = 17, and back
	ld hl,(DataCount)
	ld de,saveSScreen
	add hl,de
	ex de,hl			; DE = the end of the data codewords
	ld hl,(OutPtr)
	ld c,236
Pad:
	or a
	sbc hl,de
	add hl,de
	jr nc,Padded
	ld (hl),c
	inc hl
	ld a,c
	xor 253
	ld c,a
	jr Pad
Padded:

; ---------- error correction ----------

	call GFTables			; exp and log tables in L₃

; Generator polynomial (x-2⁰)(x-2¹)...(x-2^(R-1)), coefficients from the highest power down;
; Gen+0 stays 1. Start with 1, then multiply by (x+2^I) for each I: from the top down,
; coefficient J ^= coefficient J-1 · 2^I (that product done with logs: exp(log C + I)).
	ld a,(ECPerBlock)
	ld b,a
	ld hl,Gen+1
GenClear:
	ld (hl),0
	inc hl
	djnz GenClear
	ld hl,Gen
	ld (hl),1
	ld c,0				; C = I
GenFactor:
	ld hl,Gen+1
	ld e,c
	ld d,0
	add hl,de			; HL = coefficient J = I+1
	ld b,c
	inc b				; B = J, counting down to 1
GenTerm:
	dec hl
	ld a,(hl)			; coefficient J-1
	inc hl
	or a
	jr z,GenNext
	push hl
	ld l,a
	ld h,0
	ld de,LogTable
	add hl,de
	ld l,(hl)			; log C, plus I (at most 254 + 29)
	ld h,0
	ld e,c
	ld d,0
	add hl,de
	ld de,ExpTable
	add hl,de
	ld a,(hl)
	pop hl
	xor (hl)
	ld (hl),a
GenNext:
	dec hl
	djnz GenTerm
	inc c
	ld a,(ECPerBlock)
	cp c
	jr nz,GenFactor
; Store coefficients 1..R as logs, which is what RS uses (none of them is 0 for R ≤ 30, so
; every log exists)
	ld hl,Gen+1
	ld a,(ECPerBlock)
	ld b,a
GenLogs:
	ld e,(hl)
	ld d,0
	push hl
	ld hl,LogTable
	add hl,de
	ld a,(hl)
	pop hl
	ld (hl),a
	inc hl
	djnz GenLogs

; EC codewords for each block, R per block, from ECOut. Blocks are M/B long; the last M mod
; B are one byte longer. B is 1, 2 or 4, so the division counts subtractions.
	ld hl,(DataCount)
	ld a,(Blocks)
	ld e,a
	ld d,0
	ld bc,0
BlockDiv:
	or a
	sbc hl,de
	jr c,BlockDivDone
	inc bc
	jr BlockDiv
BlockDivDone:
	add hl,de
	ld a,c
	ld (ShortLen),a
	ld a,l
	ld (LongBlocks),a
	ld hl,saveSScreen
	ld (BlockPtr),hl
	ld hl,ECOut
	ld (ECPtr),hl
	ld a,(Blocks)
	ld b,a				; B = blocks left, including this one
ECBlock:
	push bc
	ld a,(LongBlocks)		; a long block when blocks left ≤ M mod B
	cp b
	ld a,(ShortLen)
	jr c,ECShort
	inc a
ECShort:
	ld c,a
	call RS
	pop bc
	djnz ECBlock

; ---------- drawing ----------

; S = 4V+17 modules a side; RowOff and ColOff center the symbol on the 96×64 screen (row 31,
; column 47 in the middle)
	ld a,(Version)
	add a,a
	add a,a
	add a,17
	ld (Size),a
	srl a
	ld b,a
	ld a,31
	sub b
	ld (RowOff),a
	ld a,47
	sub b
	ld (ColOff),a
; Both buffers cleared: the graph buffer for the drawing, L₃ (the GF tables are done with)
; for the map
	ld hl,plotSScreen
	call Clear768
	ld hl,Map
	call Clear768

; The map of the function modules: a set pixel = not a data module. The three finders with
; their separators and format areas, the timing row and column, and for v7+ the two version
; information blocks. Alignment patterns are added by AP below. (Rect: column B, row C,
; width D, height E.)
	ld ix,Map
	ld bc,0000h
	ld de,0909h
	call RectOn
	ld a,(Size)
	sub 8
	ld b,a
	ld c,0
	ld de,0809h
	call RectOn
	ld b,0
	ld a,(Size)
	sub 8
	ld c,a
	ld de,0908h
	call RectOn
	ld bc,0006h
	ld a,(Size)
	ld d,a
	ld e,1
	call RectOn
	ld bc,0600h
	ld d,1
	ld a,(Size)
	ld e,a
	call RectOn
	ld a,(Version)
	cp 7
	jr c,MapDone
	ld a,(Size)
	sub 11
	ld b,a
	ld c,0
	ld de,0306h
	call RectOn
	ld b,0
	ld a,(Size)
	sub 11
	ld c,a
	ld de,0603h
	call RectOn
MapDone:

; Finder patterns at the top left, top right and bottom left
	ld bc,0000h
	call FP
	ld a,(Size)
	sub 7
	ld b,a
	ld c,0
	call FP
	ld b,0
	ld a,(Size)
	sub 7
	ld c,a
	call FP

; Timing patterns: row 6 and column 6, dark at the even positions between the separators,
; 8 to S-9: that is 2V+1 modules each way
	ld a,(Version)
	add a,a
	inc a
	ld b,a
	ld a,8
Timing:
	push bc
	push af
	ld b,a
	ld c,6
	call PlotModule
	pop af
	push af
	ld b,6
	ld c,a
	call PlotModule
	pop af
	pop bc
	add a,2
	djnz Timing

; Alignment patterns (v2+). Coordinates at Align: v2-6 {6, S-7}; v7-11 {6, middle, S-7}.
; Every pair of them gets a pattern except those that would overlap a finder: skip a pair
; with 6 in it unless the other coordinate is the middle (v2-6: only (S-7,S-7) is left; v7+:
; (6,6), (6,S-7) and (S-7,6) go).
	ld a,(Version)
	cp 2
	jr c,AlignDone
	ld hl,Align
	ld (hl),6
	inc hl
	ld b,a
	ld a,(Size)
	sub 7
	ld c,a				; C = S-7
	ld a,b
	cp 7
	jr nc,AlignThree
	xor a
	ld (AlignMid),a
	ld (hl),c
	ld a,2
	jr AlignCounted
AlignThree:
	ld a,(Size)
	dec a
	srl a
	ld (AlignMid),a
	ld (hl),a
	inc hl
	ld (hl),c
	ld a,3
AlignCounted:
	ld (AlignCount),a
	xor a
	ld (AlignX),a
AlignLoopX:
	xor a
	ld (AlignY),a
AlignLoopY:
	ld hl,Align
	ld a,(AlignX)
	ld e,a
	ld d,0
	add hl,de
	ld b,(hl)			; B = the column
	ld hl,Align
	ld a,(AlignY)
	ld e,a
	add hl,de
	ld c,(hl)			; C = the row
	ld a,(AlignMid)
	ld d,a
	ld a,b				; column 6 and the row isn't the middle: skip
	cp 6
	jr nz,AlignRow6
	ld a,c
	cp d
	jr nz,AlignNext
AlignRow6:
	ld a,c				; row 6 and the column isn't the middle: skip
	cp 6
	jr nz,AlignDraw
	ld a,b
	cp d
	jr nz,AlignNext
AlignDraw:
	call AP
AlignNext:
	ld hl,AlignCount
	ld a,(AlignY)
	inc a
	ld (AlignY),a
	cp (hl)
	jr nz,AlignLoopY
	ld a,(AlignX)
	inc a
	ld (AlignX),a
	cp (hl)
	jr nz,AlignLoopX
AlignDone:

; Format information (always EC L, mask 0) and the dark module, from FormatDark: 9 (column,
; row) pairs near the top left finder, then 3 values k drawn at (S-k,8) along the top right,
; then 7 drawn at (8,S-k) down the bottom left (the last is the dark module)
	ld hl,FormatDark
	ld b,9
FormatPairs:
	push bc
	ld b,(hl)
	inc hl
	ld c,(hl)
	inc hl
	push hl
	call PlotModule
	pop hl
	pop bc
	djnz FormatPairs
	ld b,3
FormatRow:
	push bc
	ld a,(Size)
	sub (hl)
	inc hl
	ld b,a
	ld c,8
	push hl
	call PlotModule
	pop hl
	pop bc
	djnz FormatRow
	ld b,7
FormatColumn:
	push bc
	ld a,(Size)
	sub (hl)
	inc hl
	ld c,a
	ld b,8
	push hl
	call PlotModule
	pop hl
	pop bc
	djnz FormatColumn

; Version information (v7+): 18 bits, lowest first. Bit I goes to column S-11+(I mod 3),
; row I/3 (the top right block) and to the transposed place (the bottom left block). The
; word is shifted right after each bit; bits 16 and 17 are 0, as the word runs out.
	ld a,(Version)
	cp 7
	jr c,VersionDone
	sub 7
	add a,a
	ld e,a
	ld d,0
	ld hl,VersionInfo
	add hl,de
	ld e,(hl)
	inc hl
	ld d,(hl)
	ld (VersionBits),de
	xor a
	ld (VersionIdx),a
VersionBit:
	ld hl,(VersionBits)
	srl h
	rr l
	ld (VersionBits),hl
	jr nc,VersionNext
	ld a,(VersionIdx)		; C = I/3, B = I mod 3, by counting down threes
	ld c,0
VersionDiv:
	cp 3
	jr c,VersionDivDone
	sub 3
	inc c
	jr VersionDiv
VersionDivDone:
	ld b,a
	ld a,(Size)
	sub 11
	add a,b
	ld b,a				; B = S-11 + I mod 3, C = I/3
	push bc
	call PlotModule
	pop bc
	ld a,b				; the transposed place
	ld b,c
	ld c,a
	call PlotModule
VersionNext:
	ld a,(VersionIdx)
	inc a
	ld (VersionIdx),a
	cp 18
	jr c,VersionBit
VersionDone:

; Data modules in the standard zigzag: column pairs from the right edge, the first going up,
; then down, and so on. The codewords come one at a time from CW. ShortBlocks, BlockShift,
; ShortTotal and ECTotal are set once here for CW.
	ld a,(LongBlocks)
	ld b,a
	ld a,(Blocks)
	sub b
	ld (ShortBlocks),a
	ld a,(Blocks)
	ld c,0
Log2Blocks:
	srl a
	jr c,Log2Done
	inc c
	jr Log2Blocks
Log2Done:
	ld a,c
	ld (BlockShift),a
	ld a,(ShortLen)
	ld l,a
	ld h,0
	call ShiftUp			; HL = ShortLen · blocks
	ld (ShortTotal),hl
	ld a,(ECPerBlock)
	ld l,a
	ld h,0
	call ShiftUp
	ld (ECTotal),hl
	ld hl,0
	ld (CWIndex),hl
	call CW
	ld (CWByte),a
	ld a,80h
	ld (CWBit),a
	xor a
	ld (ZigPair),a
ZigLoopPair:
	ld a,(Size)			; while the pair < S/2
	srl a
	ld b,a
	ld a,(ZigPair)
	cp b
	jr nc,ZigDone
	add a,a				; the right column: S-1-2·pair, moved left past the timing
	ld b,a				; column 6 once the pairs reach it
	ld a,(Size)
	dec a
	sub b
	cp 7
	jr nc,ZigColOK
	dec a
ZigColOK:
	ld (ZigCol),a
	xor a
	ld (ZigStep),a
ZigLoopStep:
	ld a,(ZigPair)			; odd pairs go down, even pairs go up
	rra
	ld a,(ZigStep)
	jr c,ZigDown
	ld b,a
	ld a,(Size)
	dec a
	sub b
ZigDown:
	ld c,a				; C = the row
	ld a,(ZigCol)
	ld b,a				; B = the right column, then the left one
	push bc
	call ZigModule
	pop bc
	dec b
	call ZigModule
	ld a,(ZigStep)
	inc a
	ld (ZigStep),a
	ld hl,Size
	cp (hl)
	jr nz,ZigLoopStep
	ld hl,ZigPair
	inc (hl)
	jr ZigLoopPair
ZigDone:
	bcall(_GrBufCpy)		; DispGraph
	ld hl,0
	jp Quit

; ---------- E=4: list the notes into Str3 ----------

; For prgmQR's pager: 8 characters a name, padded with space tokens, then 48 more spaces, so a
; page of 5 names read past the last one stays inside Str3. Ans = the number of notes. The
; names are gathered at L₁+8K first (at most 80, L₁+0..639). VAT walk: entries go down from
; (progPtr) to (pTemp); the type in the low 5 bits at P, the name length at P-6, the name from
; P-7 downward, the next entry at P-7-length.
ListNotes:
	xor a
	ld (ListCount),a
	ld hl,(progPtr)
	ld (ListPtr),hl
LS_Entry:
	ld hl,(ListPtr)			; while P > (pTemp)
	ld de,(pTemp)
	or a
	sbc hl,de
	jr z,LS_Done
	jr c,LS_Done
	add hl,de
; An appvar (15h) with a name of 1-8 characters
	ld a,(hl)
	and 1Fh
	cp AppVarObj
	jr nz,LS_Next
	ld de,-6
	add hl,de
	ld a,(hl)
	dec a
	cp 8
	jr nc,LS_Next
	ld a,(ListCount)
	cp 80
	jr nc,LS_Next
; NC: a name we can open by name; NH: really a note
	call NC
	jr c,LS_Next
	ld hl,AppvarName
	ld de,OP1
	ld bc,10
	ldir
	bcall(_ChkFindSym)
	jr c,LS_Next
	call NH
	jr c,LS_Next
	ld a,(ListCount)		; the name at L₁+8K, after 8 space tokens
	ld l,a
	ld h,0
	add hl,hl
	add hl,hl
	add hl,hl
	ld de,saveSScreen
	add hl,de
	push hl
	ld (hl),29h
	ld d,h
	ld e,l
	inc de
	ld bc,7
	ldir
	pop de
	ld hl,AppvarName+1
LS_Copy:
	ld a,(hl)
	or a
	jr z,LS_Copied
	ld (de),a
	inc hl
	inc de
	jr LS_Copy
LS_Copied:
	ld hl,ListCount
	inc (hl)
LS_Next:
	ld hl,(ListPtr)			; P = P-7-length
	ld de,-6
	add hl,de
	ld e,(hl)
	ld d,0
	dec hl
	or a
	sbc hl,de
	ld (ListPtr),hl
	jr LS_Entry

; Str3 = the names and 48 spaces. Enough free RAM is checked first (the string, its size
; word and VAT entry, and a margin), so a full calculator gets 65535 instead of the OS's
; ERR:MEMORY. An old Str3 is deleted first (making one that exists would make a second).
LS_Done:
	ld a,(ListCount)
	ld l,a
	ld h,0
	add hl,hl
	add hl,hl
	add hl,hl
	ld de,48
	add hl,de
	ld (ListSize),hl
	bcall(_MemChk)			; HL = free RAM
	ld de,32
	or a
	sbc hl,de
	jp c,BadInput
	ld de,(ListSize)
	sbc hl,de
	jp c,BadInput
	ld hl,NameStr3
	call NameToOP1
	bcall(_ChkFindSym)
	jr c,LS_NoOld
	bcall(_DelVarArc)
LS_NoOld:
	ld hl,NameStr3
	call NameToOP1
	ld hl,(ListSize)
	bcall(_CreateStrng)		; DE = its size word
	inc de
	inc de
	ld a,(ListCount)
	or a
	jr z,LS_Pad
	ld l,a
	ld h,0
	add hl,hl
	add hl,hl
	add hl,hl
	ld b,h
	ld c,l
	ld hl,saveSScreen
	ldir
LS_Pad:
	ld b,48
	ld a,29h
LS_PadByte:
	ld (de),a
	inc de
	djnz LS_PadByte
	ld a,(ListCount)
	ld l,a
	ld h,0
	jr Quit

; ---------- leaving ----------

; BadInput: Ans = 65535 (bad E, V or M, or the input doesn't exist), and return.
BadInput:
	ld hl,65535

; Quit: Ans = HL, and return to prgmQR from anywhere: the stack goes back to where it was at
; the start, so this works from inside subroutines too.
Quit:
	ld sp,(SaveSP)
	bcall(_SetXXXXOP2)		; OP2 = HL as a float
	bcall(_OP2ToOP1)
	bcall(_StoAns)
	ret

; ---------- subroutines ----------

; CH: the next character → A; adds 1 to Pos (the position of the character read).
; A note (Source 3): the text starts at byte 24 of the appvar, so the character is byte
; Pos+23, its calculator code mapped by MA (never 0: the text ends at the first 00h).
; Str1: A = the token's ASCII code, 0 if it has none, and ReadPtr moves past the token. A
; token is found in TokenFirst (95 first bytes, one per ASCII 32-126), or, for a two-byte
; token, its second byte in TokenSecond. Only BBh tokens have ASCII among the two-byte ones;
; BB 00 is npv(, never a character (0 in TokenSecond means a one-byte token).
; Changes AF, BC, DE, HL.
CH:
	ld hl,(Pos)
	inc hl
	ld (Pos),hl
	ld a,(Source)
	cp 3
	jr nz,CH_Str1
	ld de,23
	add hl,de
	call RB
	jp MA
CH_Str1:
	ld hl,(ReadPtr)
	ld a,(hl)
	inc hl
	ld e,a				; E = the first byte
	call IsPrefix
	jr nz,CH_OneByte
	ld d,(hl)			; D = the second byte
	inc hl
	ld (ReadPtr),hl
	ld a,e
	cp 0BBh
	jr nz,CH_None
	ld a,d
	or a
	jr z,CH_None
	ld hl,TokenSecond
	jr CH_Search
CH_OneByte:
	ld (ReadPtr),hl
	ld a,e
	ld hl,TokenFirst
CH_Search:
	ld bc,95
	cpir
	jr nz,CH_None
; found at row position 95-BC (1-95, cpir counted the match too): ASCII = 31 + that
	ld a,126
	sub c
	ret
CH_None:
	xor a
	ret

; AB: append the low B bits (1-16) of HL to the data codewords, highest first. HL is first
; shifted left so its first bit is bit 15; then each add hl,hl pushes the next bit into
; carry, and rla moves it into BitAcc (kept in A), whose old bits leave from the top. Every 8
; bits A is stored at OutPtr. Changes AF, BC, DE, HL.
AB:
	ld a,16
	sub b
	jr z,AB_Ready
AB_Align:
	add hl,hl
	dec a
	jr nz,AB_Align
AB_Ready:
	ld de,(OutPtr)
	ld a,(BitCount)
	ld c,a
	ld a,(BitAcc)
AB_Bit:
	add hl,hl
	rla
	inc c
	bit 3,c				; 8 bits?
	jr z,AB_Next
	ld (de),a
	inc de
	ld c,0
AB_Next:
	djnz AB_Bit
	ld (OutPtr),de
	ld (BitAcc),a
	ld a,c
	ld (BitCount),a
	ret

; RS: the R EC codewords of one block of C data codewords (C ≥ 1) at BlockPtr, written at
; ECPtr; then both pointers move past what they cover. Polynomial division done like a shift
; register: the remainder (R bytes, plus a 0 byte that shifts in) at Rem. For each data byte:
; F = byte xor the remainder's first byte; shift the remainder left one byte; then remainder
; ^= F · generator (coefficients 1..R, stored as logs: F·g = exp(log F + log g)).
; Changes AF, BC, DE, HL.
RS:
	ld hl,Rem
	ld a,(ECPerBlock)
	inc a
	ld b,a
RS_Clear:
	ld (hl),0
	inc hl
	djnz RS_Clear
	ld de,(BlockPtr)
RS_Byte:
	ld a,(de)
	inc de
	push de
	push bc
	ld hl,Rem
	xor (hl)			; F, and Z if it is 0
	push af
	ld de,Rem			; shift the remainder left
	ld hl,Rem+1
	ld a,(ECPerBlock)
	ld c,a
	ld b,0
	ldir
	pop af
	jr z,RS_Next
	ld l,a
	ld h,0
	ld de,LogTable
	add hl,de
	ld c,(hl)			; C = log F
	ld a,(ECPerBlock)
	ld b,a
	ld hl,Gen+1
	ld de,Rem
RS_Term:
	ld a,(hl)			; log g + log F: up to 508, so the carry is bit 8
	add a,c
	push hl
	ld l,a
	ld h,0
	rl h
	push de
	ld de,ExpTable
	add hl,de
	pop de
	ld a,(de)
	xor (hl)
	ld (de),a
	inc de
	pop hl
	inc hl
	djnz RS_Term
RS_Next:
	pop bc
	pop de
	dec c
	jr nz,RS_Byte
	ld (BlockPtr),de
	ld de,(ECPtr)
	ld hl,Rem
	ld a,(ECPerBlock)
	ld c,a
	ld b,0
	ldir
	ld (ECPtr),de
	ret

; CW: codeword CWIndex of the final (interleaved) sequence → A, read in place. The order is:
; data byte 0 of every block, byte 1 of every block, ...; then the last byte of each long
; block; then EC byte 0 of every block, byte 1, ...; then 0 (the remainder bits after the
; last codeword). The block count is 1, 2 or 4, so "mod blocks" is an and and "/ blocks" a
; shift (BlockShift). Changes AF, BC, DE, HL.
CW:
	ld hl,(CWIndex)
	ld de,(DataCount)
	or a
	sbc hl,de
	jr nc,CW_EC
	add hl,de			; HL = Q, a data codeword
	ld de,(ShortTotal)
	or a
	sbc hl,de
	jr nc,CW_Extra
	add hl,de
	ld a,(Blocks)			; block Q mod B, index Q / B in it
	dec a
	and l
	ld c,a
	call ShiftDown
	jr CW_Data
CW_Extra:
	ld a,(ShortBlocks)		; past ShortTotal: the extra last bytes of the long blocks
	add a,l
	ld c,a				; block ShortBlocks + (Q - ShortTotal)
	ld a,(ShortLen)
	ld l,a				; index ShortLen
	ld h,0
CW_Data:
; block C starts at C·ShortLen, plus 1 for each long block before it (C - ShortBlocks if
; that is positive); HL = the index in the block
	ld a,(ShortBlocks)
	ld b,a
	ld a,c
	sub b
	jr c,CW_NoLong
	ld e,a
	ld d,0
	add hl,de
CW_NoLong:
	ld a,(ShortLen)
	ld e,a
	ld d,0
	ld b,c
	inc b
	jr CW_MulTest
CW_Mul:
	add hl,de
CW_MulTest:
	djnz CW_Mul
	ld de,saveSScreen
	add hl,de
	ld a,(hl)
	ret
; EC byte (Q-M) / B of block (Q-M) mod B; the blocks' EC codewords are R apart
CW_EC:
	ld de,(ECTotal)
	or a
	sbc hl,de
	jr nc,CW_Zero
	add hl,de
	ld a,(Blocks)
	dec a
	and l
	ld c,a
	call ShiftDown
	ld a,(ECPerBlock)
	ld e,a
	ld d,0
	ld b,c
	inc b
	jr CW_ECTest
CW_ECMul:
	add hl,de
CW_ECTest:
	djnz CW_ECMul
	ld de,ECOut
	add hl,de
	ld a,(hl)
	ret
CW_Zero:
	xor a
	ret

; ShiftDown: HL / blocks; ShiftUp: HL · blocks (shifts by BlockShift). Change AF, B, HL.
ShiftDown:
	ld a,(BlockShift)
	or a
	ret z
	ld b,a
SD_Loop:
	srl h
	rr l
	djnz SD_Loop
	ret
ShiftUp:
	ld a,(BlockShift)
	or a
	ret z
	ld b,a
SU_Loop:
	add hl,hl
	djnz SU_Loop
	ret

; ZigModule: the module at column B, row C (module coordinates), if it is a data module (not
; set in the map): Mask 0 inverts a bit where column+row is even, so the module is dark iff
; its bit equals (column+row) mod 2. Then the next bit; after 8, the next codeword.
; Changes AF, BC, DE, HL.
ZigModule:
	push bc
	ld de,Map
	call PixelAddr
	and (hl)
	pop bc
	ret nz				; a function module
	ld a,b
	add a,c
	and 1
	ld d,a				; D = (column+row) mod 2
	ld a,(CWByte)
	ld hl,CWBit
	and (hl)
	jr z,ZM_Bit
	ld a,1				; A = the bit
ZM_Bit:
	cp d
	call z,PlotModule
	ld hl,CWBit
	srl (hl)
	ret nz
	ld (hl),80h
	ld hl,(CWIndex)
	inc hl
	ld (CWIndex),hl
	call CW
	ld (CWByte),a
	ret

; FP: a finder pattern with its top left module at column B, row C: a 7×7 dark square, the
; 5×5 inside inverted (cleared), a 3×3 dark center. Changes AF, BC, DE, HL, IX.
FP:
	call ToScreen
	ld ix,plotSScreen
	push bc
	ld de,0707h
	call RectOn
	pop bc
	inc b
	inc c
	push bc
	ld de,0505h
	call RectInv
	pop bc
	inc b
	inc c
	ld de,0303h
	jp RectOn

; AP: an alignment pattern centered at column B, row C: marked in the map (no offset), then
; drawn: 5×5 dark, the 3×3 inside cleared (inverted), the center dark. It draws its own light
; modules, so it doesn't matter that the timing pattern was drawn first.
; Changes AF, BC, DE, HL, IX.
AP:
	dec b
	dec b
	dec c
	dec c				; the top left corner
	push bc
	ld ix,Map
	ld de,0505h
	call RectOn
	pop bc
	call ToScreen
	ld ix,plotSScreen
	push bc
	ld de,0505h
	call RectOn
	pop bc
	inc b
	inc c
	push bc
	ld de,0303h
	call RectInv
	pop bc
	inc b
	inc c
	jr PlotOn

; ToScreen: module column B, row C → screen column B+ColOff, row C+RowOff. Changes AF.
ToScreen:
	ld a,(ColOff)
	add a,b
	ld b,a
	ld a,(RowOff)
	add a,c
	ld c,a
	ret

; PlotModule: the module at column B, row C dark (in the graph buffer, offset to the screen);
; PlotOn: the same at screen column B, row C. Change AF, DE, HL; PlotOn keeps BC.
PlotModule:
	call ToScreen
PlotOn:
	ld de,plotSScreen
	call PixelAddr
	or (hl)
	ld (hl),a
	ret

; PixelAddr: column B (0-95), row C (0-63) of the 96×64 buffer at DE → HL = its byte (12 a
; row), A = its bit (80h for the leftmost column of the byte). Changes AF, DE, HL.
PixelAddr:
	push de
	ld l,c
	ld h,0
	ld d,h
	ld e,l
	add hl,hl
	add hl,de
	add hl,hl
	add hl,hl			; 12·row
	ld a,b
	srl a
	srl a
	srl a
	ld e,a
	ld d,0
	add hl,de			; + column / 8
	pop de
	add hl,de
	ld a,b
	and 7
	ld d,a
	inc d
	ld a,80h
PA_Shift:
	dec d
	ret z
	rrca
	jr PA_Shift

; RectOn fills, RectInv inverts, the rectangle D wide and E high (both ≥ 1) with its top left
; at column B, row C of the 96×64 buffer at IX. Changes AF, BC, DE, HL.
RectOn:
	xor a
	jr Rect
RectInv:
	ld a,1
Rect:
	ld (RectOp),a
Rect_Row:
	push bc
	push de
Rect_Col:
	push de
	push ix
	pop de
	call PixelAddr
	ld e,a
	ld a,(RectOp)
	or a
	ld a,(hl)
	jr nz,Rect_Invert
	or e
	jr Rect_Store
Rect_Invert:
	xor e
Rect_Store:
	ld (hl),a
	pop de
	inc b
	dec d
	jr nz,Rect_Col
	pop de
	pop bc
	inc c
	dec e
	jr nz,Rect_Row
	ret

; Clear768: 768 zero bytes from HL (a 96×64 buffer). Changes BC, DE, HL.
Clear768:
	ld (hl),0
	ld d,h
	ld e,l
	inc de
	ld bc,767
	ldir
	ret

; GFTables: the GF(256) tables in L₃ (field polynomial 11Dh): exp twice, then log. C = 2^I
; as I goes 0-254; doubling past 8 bits drops bit 8 (the carry) and xors with 1Dh (11Dh's
; low byte). Changes AF, BC, DE, HL.
GFTables:
	ld hl,ExpTable
	ld c,1
	ld b,0
GFLoop:
	ld (hl),c			; exp[I]
	push hl
	ld de,255
	add hl,de
	ld (hl),c			; exp[I+255]
	ld hl,LogTable
	ld e,c
	ld d,0
	add hl,de
	ld (hl),b			; log[C] = I
	pop hl
	inc hl
	ld a,c
	add a,a
	jr nc,GFNoCarry
	xor 1Dh
GFNoCarry:
	ld c,a
	inc b
	ld a,b
	cp 255
	jr nz,GFLoop
	ret

; MA: calculator character code C → output byte A. Most go out unchanged; the calculator's
; swaps are undone so a character never poses as another ASCII one: θ (5Bh) and [ (C1h)
; swap, ⁴ (24h) and $ (F2h) swap, Enter (D6h) and 0Ah swap, F1h (the space where a line
; wrapped) → space, D2h (hyphen) → -. The negative sign (1Ah) isn't ASCII, so it stays.
; Changes AF, BC, HL.
MA:
	ld a,c
	ld hl,SwapFrom
	ld bc,8
	cpir
	ret nz
	ld hl,SwapTo+7			; found at position 8-BC (1-8): its pair is at SwapTo+7-BC
	or a
	sbc hl,bc
	ld a,(hl)
	ret

; NF: open the note named in Str2: carry if there is none (no Str2, a name that isn't 1-8
; characters, no such appvar, or not a note); else HL = its text length [T] and NH has set
; NotePage, NoteAddr and NoteSize. The name ends at the first space token (29h) or at the end
; of Str2; it goes to AppvarName as an OP1 name, 15h, the name, 0. Changes everything.
NF:
	ld hl,NameStr2
	call FindVar
	ret c
	ex de,hl
	ld c,(hl)
	inc hl
	ld b,(hl)
	inc hl				; BC = Str2's size, HL = its first token
	ld de,AppvarName+1
	ld a,1				; A = 1 + the characters copied
NF_Copy:
	push af
	ld a,b
	or c
	jr z,NF_Copied
	ld a,(hl)
	cp 29h
	jr z,NF_Copied
	pop af
	cp 9				; a 9th character: too long (stop here, not after L₁)
	jr z,NF_Fail
	push af
	ld a,(hl)
	ld (de),a
	inc de
	inc hl
	dec bc
	pop af
	inc a
	jr NF_Copy
NF_Copied:
	pop af
	dec a				; 0 characters: no name
	jr z,NF_Fail
	xor a
	ld (de),a
	ld hl,AppvarName
	ld (hl),AppVarObj
	ld de,OP1
	ld bc,10
	ldir
	bcall(_ChkFindSym)
	ret c
	call NH
	ret c
; The text runs from byte 24 to a 00h; the appvar size bounds the scan (size-24 bytes at most)
	ld hl,0
NF_Measure:
	push hl
	ld de,24
	add hl,de
	ex de,hl
	ld hl,(NoteSize)
	or a
	sbc hl,de			; at the size: stop
	jr z,NF_Measured
	ex de,hl
	call RB
	ld a,c
	or a
	jr z,NF_Measured
	pop hl
	inc hl
	jr NF_Measure
NF_Measured:
	pop hl
	or a
	ret
NF_Fail:
	scf
	ret

; NH: after _ChkFindSym found the appvar (B = its page, DE = its data in RAM or its archive
; entry in flash): set NotePage, NoteAddr (its data, after the size word) and NoteSize; carry
; if it isn't a note (smaller than 27 bytes, or no NoteFolio signature).
; An archive entry: FCh, a size word, the VAT entry's 6 bytes, the name length (byte 9), the
; name, then the data: the size word at 10 + the name length. Changes everything.
NH:
	ld a,b
	ld (NotePage),a
	or a
	jr nz,NH_Flash
	ex de,hl
	ld e,(hl)
	inc hl
	ld d,(hl)
	inc hl
	ld (NoteAddr),hl
	ld (NoteSize),de
	jr NH_Check
NH_Flash:
	ld hl,-4000h
	add hl,de
	ld (NoteAddr),hl		; the entry, as an offset from 4000h on NotePage
	ld hl,9
	call RB				; C = the name length
	ld l,c
	ld h,0
	ld de,10
	add hl,de
	call NoteSeek			; now at the size word
	ld hl,0
	call RB
	push bc
	ld hl,1
	call RB
	pop de
	ld d,c
	ld (NoteSize),de
	ld hl,2
	call NoteSeek			; now at the data
NH_Check:
	ld hl,(NoteSize)
	ld de,27
	or a
	sbc hl,de
	ret c
; The first 4 bytes must be the NoteFolio signature
	ld hl,0
NH_Signature:
	push hl
	call RB
	pop hl
	push hl
	ld de,Signature
	add hl,de
	ld a,(hl)
	pop hl
	cp c
	scf
	ret nz
	inc hl
	ld a,l
	cp 4
	jr nz,NH_Signature
	or a
	ret

; RB: byte HL of the open note's data → C: from RAM, or from flash with _LoadCIndPaged.
; Changes AF, B, DE, HL (and everything, for a note in flash: it is a bcall).
RB:
	call NotePtr
	ld a,b
	or a
	jr nz,RB_Flash
	ld c,(hl)
	ret
RB_Flash:
	bcall(_LoadCIndPaged)		; C = the byte at page B, address HL
	ret

; NoteSeek: move NoteAddr (and NotePage) HL bytes on. Changes AF, B, DE, HL.
NoteSeek:
	call NotePtr
	ld a,b
	ld (NotePage),a
	or a
	jr z,NS_RAM
	res 6,h				; back to an offset from 4000h
NS_RAM:
	ld (NoteAddr),hl
	ret

; NotePtr: where byte HL of the open note's data is: B = 0 and HL = the address in RAM, or
; B = the flash page and HL = the address (4000h-7FFFh). In flash, NoteAddr + HL can pass a
; 16 KB page, even several (a note can be 32 KB, so the sum can need 17 bits): the page goes
; up by the sum's bits 14 and up, and the address keeps bits 0-13. Changes AF, B, DE, HL.
NotePtr:
	ld de,(NoteAddr)
	add hl,de
	sbc a,a				; A = FFh if the sum carried out of 16 bits (bit 16)
	ld e,a
	ld a,(NotePage)
	ld b,a
	or a
	ret z				; RAM: B = 0, HL = the address
	ld a,e
	and 4				; bit 16 = 4 pages
	ld e,a
	ld a,h
	rlca
	rlca
	and 3				; bits 14-15
	add a,e
	add a,b
	ld b,a
	ld a,h
	and 3Fh
	or 40h
	ld h,a
	ret

; NC: copy the VAT name of the entry at ListPtr (its length at P-6, the name from P-7 down)
; to AppvarName as an OP1 name (15h, the name, 0). Carry unless every character is 0-9, A-Z
; or θ (5Bh, the 27th "letter"): those are also their own tokens, so prgmQR can show the name
; and pass it back in Str2. Changes AF, BC, DE, HL.
NC:
	ld hl,(ListPtr)
	ld de,-6
	add hl,de
	ld b,(hl)			; B = the length (1-8)
	dec hl
	ld de,AppvarName
	ld a,AppVarObj
	ld (de),a
	inc de
	ld c,0				; C = 1 once a character fails
NC_Char:
	ld a,(hl)
	ld (de),a
	inc de
	dec hl
	sub '0'				; 0-9, or A-Z and θ (A-θ = 41h-5Bh)
	cp 10
	jr c,NC_OK
	sub 'A'-'0'
	cp 27
	jr c,NC_OK
	ld c,1
NC_OK:
	djnz NC_Char
	xor a
	ld (de),a
	ld a,c
	rra				; carry = a character failed
	ret

; NameToOP1: copy a 9-byte OS name from HL to OP1. Changes BC, DE, HL.
NameToOP1:
	ld de,OP1
	ld bc,9
	ldir
	ret

; IsPrefix: Z if A is the first byte of a two-byte token. Changes F, BC; keeps A, DE, HL.
IsPrefix:
	push hl
	ld hl,Prefixes
	ld bc,11
	cpir
	pop hl
	ret

; AV: ASCII A → its alphanumeric value in A (0-9 digits, 10-35 A-Z, 36-44 space $ % * + - .
; / :), carry clear; carry set if alphanumeric mode has none. The subtractions wrap around
; below 0 (a code below '0' becomes a large number), and adding 'A' back undoes them, so A is
; the ASCII code again when it reaches the punctuation table. Changes AF, BC, HL.
AV:
	sub '0'
	cp 10
	jr c,AV_OK			; 0-9
	sub 'A'-'0'
	cp 26
	jr nc,AV_Punct
	add a,10			; A-Z → 10-35
AV_OK:
	or a
	ret
AV_Punct:
	add a,'A'
	ld hl,Punct
	ld bc,9
	cpir
	scf
	ret nz
; found at position 9-BC (1-9): value 35 + that
	ld a,44
	sub c
	ret

; GV: the OS real variable named A ('E', 'V', ...) → HL as an integer (FloatToInt), 0 if it
; doesn't exist or is archived. Changes AF, BC, DE, HL, OP1.
GV:
	call RealToOP1
	call FindOP1
	ld hl,0
	ret c
	; fall through: DE = the float

; FloatToInt: the 9-byte float at DE → HL, its integer part (the fraction is dropped). A
; negative number, or one of 65536 or more, gives 65535: every parameter rejects or clamps
; that. (Axe's float{ isn't documented for those, so this is a choice, not a copy.)
; The float: a sign byte (bit 7), the exponent byte (80h + the power of ten), then 14 BCD
; digits, two to a byte, the first being the units digit when the exponent is 80h. So the
; integer part is the first exponent-7Fh digits. Changes AF, BC, DE, HL.
FloatToInt:
	ld a,(de)
	rla				; sign → carry
	jr c,FTI_Max
	inc de
	ld a,(de)
	sub 80h				; A = the power of ten
	ld hl,0
	ret c				; below 1: 0
	cp 5
	jr nc,FTI_Max			; 100000 or more
	inc a
	ld b,a				; B = digits before the point, 1-5
	inc de				; the first pair of digits
	ld c,0				; C = 0 for the high digit of the byte, 1 for the low one
FTI_Digit:
	ld a,(de)
	bit 0,c
	jr nz,FTI_Low
	rrca
	rrca
	rrca
	rrca
FTI_Low:
	and 0Fh
	push de				; HL = 10·HL + A, any carry out of 16 bits is too big
	ld d,h
	ld e,l
	add hl,hl
	jr c,FTI_Over
	add hl,hl
	jr c,FTI_Over
	add hl,de			; ·5
	jr c,FTI_Over
	add hl,hl			; ·10
	jr c,FTI_Over
	ld e,a
	ld d,0
	add hl,de
	jr c,FTI_Over
	pop de
	ld a,c				; next digit: the low half of this byte, or the next byte
	xor 1
	ld c,a
	jr nz,FTI_Next
	inc de
FTI_Next:
	djnz FTI_Digit
	ret
FTI_Over:
	pop de
FTI_Max:
	ld hl,65535
	ret

; StoreB: B = HL (as a float), if a real variable B exists in RAM; nothing otherwise (the
; engine never creates variables). A complex B is left alone: a real's float in its first
; half would leave it half real. Changes AF, BC, DE, HL, OP1, OP2.
StoreB:
	push hl
	ld a,'B'
	call RealToOP1
	call FindOP1
	jr c,StoreB_None
	ld a,(hl)			; HL = its VAT entry: the type is in the low 5 bits
	and 1Fh
	jr nz,StoreB_None
	pop hl
	push de				; DE = its data
	bcall(_SetXXXXOP2)		; OP2 = HL as a float
	pop de
	ld hl,OP2
	ld bc,9
	ldir
	ret
StoreB_None:
	pop hl
	ret

; RealToOP1: OP1 = the name of the real variable A: type 0, the letter, 0, 0. Changes HL.
RealToOP1:
	ld hl,OP1
	ld (hl),RealObj
	inc hl
	ld (hl),a
	inc hl
	ld (hl),0
	inc hl
	ld (hl),0
	ret

; FindVar: find the OS variable whose name (9 bytes, OP1 style: type, name, zeros) is at HL.
; Carry set if it doesn't exist or is archived; else DE = its data (in RAM) and HL = its VAT
; entry. Changes AF, BC, DE, HL, OP1.
FindVar:
	ld de,OP1
	ld bc,9
	ldir
FindOP1:			; the same, with the name already in OP1
	bcall(_ChkFindSym)
	ret c
	ld a,b				; B = flash page, 0 in RAM
	or a
	ret z
	scf
	ret

; ---------- data ----------

NameStr1:	.db StrngObj, tVarStrng, tStr1, 0, 0, 0, 0, 0, 0
NameBIN:	.db ListObj, tVarLst, "BIN", 0, 0, 0, 0
NameStr2:	.db StrngObj, tVarStrng, tStr2, 0, 0, 0, 0, 0, 0
NameStr3:	.db StrngObj, tVarStrng, tStr3, 0, 0, 0, 0, 0, 0

; The first 4 bytes of every NoteFolio appvar (GDB8)
Signature:	.db 0F3h, 047h, 0BFh, 0AFh
; Note characters that change on the way out ([ θ $ ⁴ Enter 0Ah, wrapped-line space, hyphen),
; and what each becomes (GDB9+10, GDB9+20; see MA)
SwapFrom:	.db 0C1h, 05Bh, 0F2h, 024h, 0D6h, 00Ah, 0F1h, 0D2h
SwapTo:		.db 05Bh, 0C1h, 024h, 0F2h, 00Ah, 0D6h, 020h, 02Dh

; Per version 1-11 at EC level L (GDB3, GDB4, GDB5): data codewords (words), EC codewords per
; block, blocks
DataWords:	.dw 19, 34, 55, 80, 108, 136, 156, 194, 232, 274, 324
ECTable:	.db 7, 10, 15, 20, 26, 18, 20, 24, 30, 18, 20
BlockTable:	.db 1, 1, 1, 1, 1, 2, 2, 2, 2, 4, 4
; Character count widths: byte mode v1-9, v10+, alphanumeric v1-9, v10+ (GDB5+11)
CountWidths:	.db 8, 16, 9, 11
; Version information for v7-11 (GDB6; words: 18-bit BCH codes whose top 2 bits are 0 for
; versions below 16, so 16 bits suffice)
VersionInfo:	.dw 07C94h, 085BCh, 09A99h, 0A4D3h, 0BBF6h
; The dark modules of the format information (GDB7). EC L and mask 0 always give 77C4h, so
; only the dark ones are listed: 9 (column,row) pairs near the top left finder, then 3 values
; k drawn at (S-k,8) and 7 values k drawn at (8,S-k); the last is the dark module that every
; QR code has, at (8,S-8)
FormatDark:	.db 8,2, 8,7, 8,8, 7,8, 5,8, 4,8, 2,8, 1,8, 0,8
		.db 3, 7, 8
		.db 7, 6, 5, 3, 2, 1, 8

; The first bytes of the two-byte tokens (the Axe engine's GDB1)
Prefixes:	.db 05Ch, 05Dh, 05Eh, 060h, 061h, 062h, 063h, 07Eh, 0AAh, 0BBh, 0EFh

; Alphanumeric punctuation in value order, values 36-44: space $ % * + - . / : (GDB9)
Punct:		.db " $%*+-./:"

; The token for each ASCII character 32-126 (GDB0), as two 95-byte rows: the first bytes
; (BBh for the lowercase letters and other two-byte ones, which are all BB-prefixed), then
; the second bytes (0 for a one-byte token). Position in a row + 31 = the ASCII code.
TokenFirst:
	.db 029h, 02Dh, 02Ah, 0BBh, 0BBh, 0BBh, 0BBh, 0AEh, 010h, 011h, 082h, 070h, 02Bh, 071h, 03Ah, 083h
	.db 030h, 031h, 032h, 033h, 034h, 035h, 036h, 037h, 038h, 039h, 03Eh, 0BBh, 06Bh, 06Ah, 06Ch, 0AFh
	.db 0BBh, 041h, 042h, 043h, 044h, 045h, 046h, 047h, 048h, 049h, 04Ah, 04Bh, 04Ch, 04Dh, 04Eh, 04Fh
	.db 050h, 051h, 052h, 053h, 054h, 055h, 056h, 057h, 058h, 059h, 05Ah, 006h, 0BBh, 007h, 0F0h, 0BBh
	.db 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh
	.db 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 0BBh, 008h, 0BBh, 009h, 0BBh
TokenSecond:
	.db 000h, 000h, 000h, 0D2h, 0D3h, 0DAh, 0D4h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h
	.db 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 0D6h, 000h, 000h, 000h, 000h
	.db 0D1h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h
	.db 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 000h, 0D7h, 000h, 000h, 0D9h
	.db 0D5h, 0B0h, 0B1h, 0B2h, 0B3h, 0B4h, 0B5h, 0B6h, 0B7h, 0B8h, 0B9h, 0BAh, 0BCh, 0BDh, 0BEh, 0BFh
	.db 0C0h, 0C1h, 0C2h, 0C3h, 0C4h, 0C5h, 0C6h, 0C7h, 0C8h, 0C9h, 0CAh, 000h, 0D8h, 000h, 0CFh
